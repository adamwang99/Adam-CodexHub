<Window x:Class="AdamCodexHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:mvvm="clr-namespace:AdamCodexHub.App.Mvvm"
        xmlns:vm="clr-namespace:AdamCodexHub.App.ViewModels"
        Title="Adam CodexHub"
        Style="{StaticResource AppWindow}"
        Width="1200"
        Height="780"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Ambient glow layers painted behind content for the glass depth effect -->
        <RadialGradientBrush x:Key="AmbientGold" Center="0.95,0.0" GradientOrigin="0.95,0.0" RadiusX="1.0" RadiusY="1.0">
            <GradientStop Offset="0" Color="#4CD89B2B" />
            <GradientStop Offset="0.55" Color="#1CD89B2B" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientAqua" Center="0.0,1.05" GradientOrigin="0.0,1.05" RadiusX="1.0" RadiusY="1.0">
            <GradientStop Offset="0" Color="#3E2FD0C8" />
            <GradientStop Offset="0.55" Color="#182FD0C8" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientAmberWarm" Center="0.45,1.05" GradientOrigin="0.45,1.05" RadiusX="0.9" RadiusY="0.75">
            <GradientStop Offset="0" Color="#38E0A83C" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientMauve" Center="1.02,0.65" GradientOrigin="1.02,0.65" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Offset="0" Color="#288A6FD8" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientRose" Center="0.12,0.5" GradientOrigin="0.12,0.5" RadiusX="0.75" RadiusY="0.7">
            <GradientStop Offset="0" Color="#26C77E8E" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientTop" Center="0.6,-0.05" GradientOrigin="0.6,-0.05" RadiusX="1.1" RadiusY="0.7">
            <GradientStop Offset="0" Color="#30FFFFFF" />
            <GradientStop Offset="0.6" Color="#0AFFFFFF" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>

        <!-- Soft aqua glow used by the "Show all providers" ON state -->
        <DropShadowEffect x:Key="AquaGlowToggle" BlurRadius="9" ShadowDepth="0" Opacity="0.6" Color="#2FD0C8" />

        <!-- ============ Windows-style caption buttons (right side of the title bar) ============ -->
        <Style x:Key="WinCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="58" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#E6FFFFFF" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="Transparent" CornerRadius="0">
                            <TextBlock x:Name="Glyph"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="10"
                                       Foreground="{TemplateBinding Foreground}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="min">
                                                <Setter Property="Text" Value="&#xE921;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="max">
                                                <Setter Property="Text" Value="&#xE922;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="restore">
                                                <Setter Property="Text" Value="&#xE923;" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="close">
                                                <Setter Property="Text" Value="&#xE8BB;" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Generic hover for minimize / maximize / restore -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26FFFFFF" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </Trigger>
                            <!-- Windows 11 close button: solid red hover with white glyph -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Root" Property="Background" Value="#E81123" />
                                <Setter Property="Foreground" Value="#FFFFFFFF" />
                            </MultiTrigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#59FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ EN / VI language toggle (segmented pill) ============ -->
        <Style x:Key="LangToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="66" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Shell"
                                CornerRadius="13"
                                BorderThickness="1"
                                BorderBrush="{StaticResource BrushHairlineStrong}"
                                Background="{StaticResource BrushCardGlass}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- Sliding thumb: sits under the ACTIVE segment -->
                                <Border x:Name="Thumb"
                                        Grid.Column="0"
                                        Margin="1"
                                        CornerRadius="11"
                                        Background="{StaticResource BrushGold}" />
                                <TextBlock x:Name="EnLabel"
                                           Grid.Column="0"
                                           Text="EN"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#FF161616" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                    <Setter Property="Foreground" Value="#99C4C4C4" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="ViLabel"
                                           Grid.Column="1"
                                           Text="VI"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#99C4C4C4" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                    <Setter Property="Foreground" Value="#FF161616" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="Grid.Column" Value="1" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ "Show all providers" pill switch (ON / OFF unmistakable) ============ -->
        <Style x:Key="ShowAllToggleStyle" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="0.5" Color="#1EFFFFFF" />
                        <GradientStop Offset="1" Color="#0EFFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{StaticResource ControlRadius}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                <Setter Property="Effect" Value="{StaticResource AmberGlowHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Home "How it works" feature-flow diagram ============ -->
        <!-- Nested dark-glass surface shared by the three flow nodes -->
        <LinearGradientBrush x:Key="FlowNodeBack" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#70161616" />
            <GradientStop Offset="0.45" Color="#4D161616" />
            <GradientStop Offset="1" Color="#38161616" />
        </LinearGradientBrush>
        <!-- Rounded glass node card -->
        <Style x:Key="FlowNodeCard" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource FlowNodeBack}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="14,13" />
        </Style>
        <!-- Circular tinted icon disc used on every node -->
        <Style x:Key="FlowNodeIconDisc" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Soft repeating pulse for the two flow arrows; removed cleanly on Unloaded -->
        <Style x:Key="FlowArrowGlyph" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2192;" />
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="7" ShadowDepth="0" Opacity="0.35" Color="#2FD0C8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard x:Name="FlowArrowPulse">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.2"
                                             To="1"
                                             Duration="0:0:1.5" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
                    <RemoveStoryboard BeginStoryboardName="FlowArrowPulse" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Dual-direction connector arrows between flow nodes. The top arrow (aqua →) sends,
             the bottom arrow (amber ←) returns; they blink in opposite phase like live data
             exchange. Storyboards stop cleanly on Unloaded. -->
        <Style x:Key="FlowArrowSend" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2192;" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.45" Color="#2FD0C8" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard x:Name="FlowSendBlink">
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.15" To="1" Duration="0:0:0.65" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
                    <RemoveStoryboard BeginStoryboardName="FlowSendBlink" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FlowArrowRecv" TargetType="TextBlock">
            <Setter Property="Text" Value="&#x2190;" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#E0D89B2B" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="0" Opacity="0.45" Color="#D89B2B" />
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard x:Name="FlowRecvBlink">
                        <Storyboard BeginTime="0:0:0.65" RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             From="0.15" To="1" Duration="0:0:0.65" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="FrameworkElement.Unloaded">
                    <RemoveStoryboard BeginStoryboardName="FlowRecvBlink" />
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <!-- Single vertical scroll flow: toolbar, provider grid, feature-flow diagram, footer.
                 Lives inside the page ScrollViewer (MainWindow content Row 3): the ListBox no longer
                 scrolls on its own, so with "Show all providers" ON the diagram sits below the tall
                 grid and the page scrolls as one stream. -->
            <StackPanel>

                <!-- Toolbar -->
                <Border Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
                    <WrapPanel>
                        <Button Content="{DynamicResource L10n_Home_CodexAccount}"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestoreAccountCommand}"
                                Margin="0,0,10,0">
                            <Button.ToolTip>
                                <TextBlock Text="{DynamicResource L10n_Home_RestoreTip}" />
                            </Button.ToolTip>
                        </Button>
                        <Button Content="{DynamicResource L10n_Home_RefreshProviders}"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,10,0">
                            <Button.ToolTip>
                                <TextBlock Text="{DynamicResource L10n_Home_RefreshTip}" />
                            </Button.ToolTip>
                        </Button>
                        <!-- Show-all switch: track + sliding thumb + ON/OFF state label -->
                        <ToggleButton x:Name="ShowAllToggle"
                                      Style="{StaticResource ShowAllToggleStyle}"
                                      IsChecked="{Binding ShowAllProviders, Mode=TwoWay}"
                                      ToolTip="{Binding ShowAllTooltip}"
                                      automation:AutomationProperties.Name="{Binding ShowAllTooltip}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{DynamicResource L10n_Home_ShowAll}"
                                           FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0" />
                                <!-- Track -->
                                <Border Grid.Column="1" Width="40" Height="20" CornerRadius="10"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1CFFFFFF" />
                                            <Setter Property="BorderBrush" Value="#59FFFFFF" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                    <Setter Property="Background" Value="#262FD0C8" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BrushAqua}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <!-- Sliding thumb -->
                                    <Border Width="18" Height="18" CornerRadius="9"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Margin="1,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#CCFFFFFF" />
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <TranslateTransform X="0" />
                                                    </Setter.Value>
                                                </Setter>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform X="19" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                </Border>
                                <!-- ON / OFF caption -->
                                <TextBlock Grid.Column="2"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           MinWidth="24">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{DynamicResource L10n_Home_Off}" />
                                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                                                    <Setter Property="Text" Value="{DynamicResource L10n_Home_On}" />
                                                    <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                    <Setter Property="Effect" Value="{StaticResource AquaGlowToggle}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </ToggleButton>
                    </WrapPanel>
                </Border>

                <!-- Provider grid: floating logos, no enclosing card -->
                <ListBox ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         MouseDoubleClick="OnProviderDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                         automation:AutomationProperties.Name="Provider selection grid">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- No card: floating logo + text; cell wide enough that text never touches neighbors -->
                            <StackPanel Width="124" Margin="0,8" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.ToolTip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TooltipDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="{DynamicResource L10n_Home_DoubleClickTip}" Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel.ToolTip>
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.08" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.08" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <!-- Logo disc: clear glass — transparent center, hairline rim, shadow cast by the logo itself -->
                                    <Border Width="80" Height="80" CornerRadius="21"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1">
                                        <Grid Margin="9">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Effect" Value="{StaticResource LogoShadow}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Effect" Value="{StaticResource LogoGlowHover}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAqua}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding LogoSource}"
                                                   Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <!-- Status badge -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            CornerRadius="7" Padding="6,2"
                                            Margin="0,-6,-6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#73FFFFFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushBackground}" />
                                    </Border>
                                    <!-- Target badge: W = Windows Desktop (blue), CLI = terminal (black) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            CornerRadius="7" Padding="5,2"
                                            Margin="-4,0,-2,-4"
                                            ToolTip="{Binding TargetTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushAqua}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TargetLabel}" Value="CLI">
                                                        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TargetLabel}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushWhite}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,3"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Health}"
                                               Foreground="{StaticResource BrushAqua}"
                                               FontSize="10" />
                                    <TextBlock Text=" · "
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="10" />
                                    <TextBlock Text="{Binding EnabledModelLabel}"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="10" />
                                </StackPanel>
                                <TextBlock Text="{Binding KeyLabel}"
                                           Foreground="{StaticResource BrushMuted}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- ============ How it works: simple feature flow (API keys → gateway → Codex) ============ -->
                <Border Margin="0,16,0,0"
                        CornerRadius="18"
                        BorderThickness="1"
                        BorderBrush="{StaticResource BrushGlassRim}"
                        Effect="{StaticResource GlassShadowSoft}"
                        automation:AutomationProperties.Name="{DynamicResource L10n_Home_Flow_Title}">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Offset="0" Color="#24FFFFFF" />
                            <GradientStop Offset="0.55" Color="#0DFFFFFF" />
                            <GradientStop Offset="1" Color="#07FFFFFF" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Margin="22,16,22,18">
                        <!-- Card heading -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    VerticalAlignment="Center" Margin="0,0,12,0"
                                    Background="#262FD0C8" BorderBrush="#4A2FD0C8" BorderThickness="1">
                                <TextBlock Text="&#x2728;"
                                           FontSize="15"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_Home_Flow_Title}"
                                           FontSize="15.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource BrushCream}" />
                                <TextBlock Text="{DynamicResource L10n_Home_Flow_Subtitle}"
                                           FontSize="11.5"
                                           Foreground="{StaticResource BrushMuted}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Flow row: API keys → internal gateway → Codex Desktop / CLI -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- 1 · API keys (amber accent, sources listed below) -->
                            <Border Grid.Column="0" Style="{StaticResource FlowNodeCard}"
                                    BorderBrush="#3CD89B2B">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FlowNodeIconDisc}"
                                            Background="#26D89B2B" BorderBrush="#59D89B2B" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F511;" FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Keys_Title}"
                                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Keys_Sub}"
                                                   FontSize="10.5" Foreground="{StaticResource BrushMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Keys_Sources}"
                                                   FontSize="9.5" FontWeight="Medium"
                                                   Foreground="#B4D89B2B"
                                                   TextWrapping="Wrap" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Flow connector 1: dual arrows — aqua → sends up, amber ← returns below -->
                            <Grid Grid.Column="1" Width="44" Margin="2,0">
                                <TextBlock Style="{StaticResource FlowArrowSend}"
                                           VerticalAlignment="Top" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource FlowArrowRecv}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </Grid>

                            <!-- 2 · Internal gateway (aqua hero accent) -->
                            <Border Grid.Column="2" Style="{StaticResource FlowNodeCard}"
                                    BorderBrush="#4E2FD0C8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FlowNodeIconDisc}"
                                            Background="#2E2FD0C8" BorderBrush="#662FD0C8" Margin="0,0,12,0">
                                        <TextBlock Text="&#x26A1;" FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Gateway_Title}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource BrushAqua}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Gateway_Sub}"
                                                   FontSize="10.5" Foreground="{StaticResource BrushMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Flow connector 2: dual arrows — aqua → sends up, amber ← returns below -->
                            <Grid Grid.Column="3" Width="44" Margin="2,0">
                                <TextBlock Style="{StaticResource FlowArrowSend}"
                                           VerticalAlignment="Top" Margin="0,12,0,0" />
                                <TextBlock Style="{StaticResource FlowArrowRecv}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,12" />
                            </Grid>

                            <!-- 3 · Codex Desktop / CLI -->
                            <Border Grid.Column="4" Style="{StaticResource FlowNodeCard}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Style="{StaticResource FlowNodeIconDisc}"
                                            Background="#26FFFFFF" BorderBrush="#59FFFFFF" Margin="0,0,12,0">
                                        <TextBlock Text="&#x1F4BB;" FontSize="17"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Codex_Title}"
                                                   FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{DynamicResource L10n_Home_Flow_Codex_Sub}"
                                                   FontSize="10.5" Foreground="{StaticResource BrushMuted}"
                                                   TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="{DynamicResource L10n_Home_FooterHint}"
                           Foreground="{StaticResource BrushMuted}"
                           TextWrapping="Wrap"
                           Margin="0,16,0,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderSetupViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Provider list column -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="6,0,6,10">
                            <Button Content="{DynamicResource L10n_Common_New}" Command="{Binding NewCommand}" Margin="0,0,8,0" Padding="10,6" />
                            <Button Content="{DynamicResource L10n_Common_Refresh}" Command="{Binding RefreshCommand}" Padding="10,6" />
                        </WrapPanel>
                        <Grid Grid.Row="1" Margin="10,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{DynamicResource L10n_Setup_ProviderColumn}" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="{DynamicResource L10n_Setup_StatusColumn}" Style="{StaticResource SectionLabel}">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="{DynamicResource L10n_Setup_HealthTip}"
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Providers}"
                                     SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                     automation:AutomationProperties.Name="Provider profiles">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Health}"
                                                       Foreground="{StaticResource BrushAqua}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Text="{Binding HealthTooltip}"
                                                               TextWrapping="Wrap" MaxWidth="300" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                        <!-- PROFILE -->
                        <TextBlock Text="{DynamicResource L10n_Setup_ProfileSection}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{DynamicResource L10n_Setup_ProviderId}" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider ID" />
                        <TextBlock Text="{DynamicResource L10n_Setup_DisplayName}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider display name" />
                        <TextBlock Text="{DynamicResource L10n_Setup_BaseUrl}" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider base URL" />
                        <TextBlock Text="{DynamicResource L10n_Setup_Adapter}" Style="{StaticResource FieldLabel}" />
                        <ComboBox Text="{Binding Adapter, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Margin="0,0,0,12"
                                  automation:AutomationProperties.Name="Provider adapter">
                            <ComboBoxItem Content="openai-compatible" />
                            <ComboBoxItem Content="openai-responses" />
                        </ComboBox>
                        <WrapPanel Margin="0,0,0,22">
                            <Button Content="{DynamicResource L10n_Setup_SaveProvider}" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource L10n_Common_EnableDisable}" Command="{Binding ToggleProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="{DynamicResource L10n_Setup_ChooseLogo}" Command="{Binding ChooseLogoCommand}" Margin="0,0,8,8">
                                <Button.ToolTip>
                                    <TextBlock Text="{DynamicResource L10n_Setup_ChooseLogoTip}"
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </Button.ToolTip>
                            </Button>
                            <Button Content="{DynamicResource L10n_Setup_DeleteProvider}" Style="{StaticResource DangerButton}" Command="{Binding DeleteProviderCommand}" Margin="0,0,0,8" />
                        </WrapPanel>

                        <!-- API KEYS -->
                        <TextBlock Text="{DynamicResource L10n_Setup_KeysSection}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{DynamicResource L10n_Setup_PasteHint}"
                                   Foreground="{StaticResource BrushMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Paste provider API key" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="{DynamicResource L10n_Setup_AddKey}" Style="{StaticResource PrimaryButton}" Command="{Binding AddKeyCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding Keys}"
                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      automation:AutomationProperties.Name="API key pool">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Label}" Binding="{Binding Label}" Width="2*" />
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Masked}" Binding="{Binding MaskedDisplay}" Width="*" />
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Priority}" Binding="{Binding Priority}" Width="90" />
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Health}" Binding="{Binding Health}" Width="120" />
                                    <DataGridCheckBoxColumn Header="{DynamicResource L10n_Common_Enabled}" Binding="{Binding Enabled}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Margin="0,0,0,22">
                            <Button Content="{DynamicResource L10n_Setup_TestSelected}" Command="{Binding TestKeyCommand}" Margin="0,0,8,0">
                                <Button.ToolTip>
                                    <TextBlock Text="{DynamicResource L10n_Setup_TestSelectedTip}" />
                                </Button.ToolTip>
                            </Button>
                            <Button Content="{DynamicResource L10n_Setup_TestAllKeys}" Command="{Binding TestAllKeysCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all API keys">
                                <Button.ToolTip>
                                    <TextBlock Text="{DynamicResource L10n_Setup_TestAllKeysTip}" />
                                </Button.ToolTip>
                            </Button>
                            <Button Content="{DynamicResource L10n_Common_EnableDisable}" Command="{Binding ToggleKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource L10n_Setup_MoveUp}" Command="{Binding MoveUpKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource L10n_Setup_MoveDown}" Command="{Binding MoveDownKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource L10n_Setup_DeleteKey}" Style="{StaticResource DangerButton}" Command="{Binding DeleteKeyCommand}" />
                        </WrapPanel>

                        <!-- MODELS -->
                        <TextBlock Text="{DynamicResource L10n_Setup_ModelsSection}" Style="{StaticResource SectionLabel}" />
                        <WrapPanel Margin="0,8,0,10">
                            <Button Content="{DynamicResource L10n_Setup_ScanModels}" Style="{StaticResource PrimaryButton}" Command="{Binding ScanModelsCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource L10n_Setup_TestAllModels}" Command="{Binding TestAllModelsCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all models">
                                <Button.ToolTip>
                                    <TextBlock Text="{DynamicResource L10n_Setup_TestAllModelsTip}" />
                                </Button.ToolTip>
                            </Button>
                            <Button Content="{DynamicResource L10n_Common_Refresh}" Command="{Binding RefreshCommand}" />
                        </WrapPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding Models}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      automation:AutomationProperties.Name="Discovered models">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Model}" Binding="{Binding DisplayName}" Width="2.4*" />
                                    <DataGridTemplateColumn Header="{DynamicResource L10n_Common_Status}" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding State}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Verified">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{DynamicResource L10n_Common_Score}" Binding="{Binding CompatibilityScore}" Width="70" />
                                    <DataGridCheckBoxColumn Header="{DynamicResource L10n_Common_Enabled}" Binding="{Binding Enabled}" Width="80" />
                                    <DataGridTemplateColumn Header="{DynamicResource L10n_Common_Actions}" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="{DynamicResource L10n_Common_Test}" Command="{Binding DataContext.TestModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,3" FontSize="11">
                                                        <Button.ToolTip>
                                                            <TextBlock Text="{DynamicResource L10n_Setup_TestModelTip}" />
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <Button Content="{DynamicResource L10n_Common_Enable}" Command="{Binding DataContext.ToggleModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11">
                                                        <Button.ToolTip>
                                                            <TextBlock Text="{DynamicResource L10n_Setup_ToggleModelTip}" />
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="{DynamicResource L10n_Setup_TestCompatibility}" Command="{Binding TestModelCommand}" Margin="0,0,8,0" />
                            <Button Content="{DynamicResource L10n_Common_EnableDisable}" Command="{Binding ToggleModelCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L10n_Session_ProjTarget}" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="{DynamicResource L10n_Session_ProjDir}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" automation:AutomationProperties.Name="Project directory" />
                        <TextBlock Text="{DynamicResource L10n_Session_TargetProvider}" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedTargetProvider, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,16"
                                  automation:AutomationProperties.Name="Target provider" />
                        <Button Content="{DynamicResource L10n_Session_RefreshState}" Command="{Binding RefreshProjectCommand}" Margin="0,0,0,8" />
                        <Button Content="{DynamicResource L10n_Session_Prepare}" Style="{StaticResource PrimaryButton}" Command="{Binding PrepareSwitchCommand}" />
                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <TextBlock Text="{Binding RevisionSummary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="{DynamicResource L10n_Session_Continuation}" Style="{StaticResource SectionLabel}" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding ContinuationInstruction}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,10,0,0"
                                 automation:AutomationProperties.Name="Continuation instruction" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_Diag_GatewaySection}" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GatewayStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource L10n_Diag_StartStop}" Command="{Binding ToggleGatewayCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_Diag_ConfigSection}" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CodexStatus}" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource L10n_Diag_Restore}" Command="{Binding RestoreConfigCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L10n_Diag_WarningsSection}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushGold}" />
                        <TextBlock Text="{Binding ProviderWarnings}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushCream}" />
                    </StackPanel>
                </Border>
                <Button Content="{DynamicResource L10n_Diag_Refresh}" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource L10n_Set_DefaultsSection}" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="{DynamicResource L10n_Set_Loopback}" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,16,0,8" />
                        <CheckBox Content="{DynamicResource L10n_Set_Failover}" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource L10n_Set_AutoRefresh}" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="{DynamicResource L10n_Set_Logging}" Foreground="{StaticResource BrushMuted}" IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Ambient depth layers + shell -->
    <Grid ClipToBounds="True">
        <Rectangle Fill="{StaticResource AmbientGold}" />
        <Rectangle Fill="{StaticResource AmbientAqua}" />
        <Rectangle Fill="{StaticResource AmbientAmberWarm}" />
        <Rectangle Fill="{StaticResource AmbientMauve}" />
        <Rectangle Fill="{StaticResource AmbientRose}" />
        <Rectangle Fill="{StaticResource AmbientTop}" />
        <!-- Frosted milk veil: diffuses the glow so panels read as frosted glass, not raw color -->
        <Rectangle Fill="{StaticResource BrushGlassFill}" />

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="66" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar (frameless logo left, EN/VI toggle + Windows controls right) ============ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0"
                    Background="#4D0D0D0D"
                    BorderBrush="{StaticResource BrushGlassRim}"
                    BorderThickness="1,1,1,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid Margin="14,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- App identity: large crisp logo (no rounded frame) + name -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/adam-codexhub-logo.png"
                               Width="70" Height="70"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               VerticalAlignment="Center">
                            <Image.Effect>
                                <!-- Soft drop shadow keeps the logo floating over the glass -->
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5" Color="#000000" />
                            </Image.Effect>
                        </Image>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="Adam CodexHub" FontWeight="SemiBold" FontSize="15"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{DynamicResource L10n_Title_ControlHub}" Foreground="{StaticResource BrushMuted}" FontSize="11"
                                       VerticalAlignment="Center" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <!-- Right: status chips + EN/VI toggle + Windows caption buttons -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="8,3" Margin="0,0,6,0"
                                Background="#12FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_Title_ActivePrefix}" Foreground="{StaticResource BrushMuted}" FontSize="10.5" />
                                <TextBlock Text="{Binding ActiveProvider, Mode=OneWay}" FontWeight="SemiBold" FontSize="10.5" />
                            </StackPanel>
                        </Border>
                        <Border CornerRadius="8" Padding="8,3" Margin="0,0,10,0"
                                Background="#12FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                            <TextBlock Text="{Binding GatewayStatus}" Foreground="{StaticResource BrushAqua}" FontSize="10.5" VerticalAlignment="Center" />
                        </Border>

                        <!-- Language toggle: EN | VI (checked = Vietnamese) -->
                        <ToggleButton x:Name="LanguageToggle"
                                      Style="{StaticResource LangToggleStyle}"
                                      IsChecked="False"
                                      Checked="LanguageToggle_Checked"
                                      Unchecked="LanguageToggle_Unchecked"
                                      VerticalAlignment="Center"
                                      Margin="0,0,4,0"
                                      ToolTip="{DynamicResource L10n_Toggle_Tooltip}"
                                      automation:AutomationProperties.Name="Switch UI language" />

                        <!-- Windows caption buttons: minimize / maximize / close -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                            <Button Style="{StaticResource WinCaptionButton}"
                                    Tag="min"
                                    Click="Minimize_Click"
                                    automation:AutomationProperties.Name="Minimize window" />
                            <Button x:Name="MaximizeButton"
                                    Style="{StaticResource WinCaptionButton}"
                                    Tag="max"
                                    Click="MaximizeRestore_Click"
                                    automation:AutomationProperties.Name="Maximize or restore window" />
                            <Button Style="{StaticResource WinCaptionButton}"
                                    Tag="close"
                                    Click="Close_Click"
                                    automation:AutomationProperties.Name="Close window" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Body: sidebar + content ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="198" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Margin="0,10,0,0"
                        Background="{StaticResource BrushSidebar}"
                        BorderBrush="{StaticResource BrushGlassRim}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="12,0,0,0"
                        Padding="10,18,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="{DynamicResource L10n_Sidebar_Control}" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />

                        <!-- Glass nav: one pill per page; active item gets an amber highlight + bold white label -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Pages}" HorizontalContentAlignment="Stretch">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0,2"
                                            Cursor="Hand"
                                            HorizontalContentAlignment="Stretch"
                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                                <Setter Property="FontWeight" Value="Normal" />
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Pill"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{StaticResource PillRadius}"
                                                                    Padding="10,8">
                                                                <ContentPresenter HorizontalAlignment="Stretch"
                                                                                  VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="#1AFFFFFF" />
                                                                </Trigger>
                                                                <Trigger Property="IsPressed" Value="True">
                                                                    <Setter TargetName="Pill" Property="Opacity" Value="0.85" />
                                                                </Trigger>
                                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                    <Setter TargetName="Pill" Property="Background" Value="#33D89B2B" />
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <!-- Active dot: glows amber on the current page -->
                                            <Border Width="7" Height="7" CornerRadius="3.5"
                                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#4DFFFFFF" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="13" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Margin="0,10,0,6">
                            <!-- About / Guide: two equal glass buttons sharing the sidebar width -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Content="{DynamicResource L10n_Sidebar_About}"
                                        Click="About_Click"
                                        Padding="10,8"
                                        Margin="0,0,4,0"
                                        HorizontalContentAlignment="Center"
                                        FontSize="12.5">
                                    <Button.ToolTip>
                                        <TextBlock Text="{DynamicResource L10n_Sidebar_AboutTip}" />
                                    </Button.ToolTip>
                                </Button>
                                <Button Grid.Column="1"
                                        Content="{DynamicResource L10n_Sidebar_Guide}"
                                        Click="Guide_Click"
                                        Padding="10,8"
                                        Margin="4,0,0,0"
                                        HorizontalContentAlignment="Center"
                                        FontSize="12.5">
                                    <Button.ToolTip>
                                        <TextBlock Text="{DynamicResource L10n_Sidebar_GuideTip}" />
                                    </Button.ToolTip>
                                </Button>
                            </Grid>
                            <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,0,0,12" />
                            <TextBlock Text="ADAM DUNG AI" Foreground="{StaticResource BrushGold}" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="22,12,16,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="{Binding CurrentPage.Subtitle}" Margin="0,5,0,16" FontSize="13" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{DynamicResource L10n_Common_RefreshAll}" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="14,8" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Border Grid.Row="2" Background="#14E66A6A" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12,9" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentPage}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <Border Background="#14E66A6A" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentPage.ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding CurrentPage.StatusMessage}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ Status bar ============ -->
            <Border Grid.Row="2" Margin="0,10,0,0"
                    CornerRadius="0,0,12,12"
                    Background="#4D0D0D0D"
                    BorderBrush="{StaticResource BrushGlassRim}"
                    BorderThickness="1,0,1,1">
                <Grid Margin="14,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11"
                               Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrushGold}"
                               FontSize="10" FontWeight="SemiBold" Text="{DynamicResource L10n_Title_StatusTag}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
