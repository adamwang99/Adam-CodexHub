<Window x:Class="AdamCodexHub.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource L10n_Guide_WindowTitle}"
        Style="{StaticResource AppWindow}"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n_Guide_WindowTitle}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushCream}" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Subtitle}"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click"
                        Style="{StaticResource NavButton}" Padding="10,6"
                        VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <StackPanel>

                    <!-- How it works in one picture -->
                    <TextBlock Text="{DynamicResource L10n_Guide_Sec1}"
                               Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Sec1Body}"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                               Margin="0,7,0,12" LineHeight="20" />

                    <!-- Numbered screenshot: the main user flow -->
                    <Border Padding="8" Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1" Margin="0,0,0,18">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_Guide_ScreenshotTitle}"
                                       Foreground="{StaticResource BrushAqua}" FontSize="12" FontWeight="SemiBold"
                                       Margin="2,0,0,8" />
                            <Image Source="Assets/guide-choose-provider-annotated.png"
                                   Stretch="Uniform" MaxWidth="900" RenderOptions.BitmapScalingMode="HighQuality" />
                        </StackPanel>
                    </Border>

                    <!-- Tab-by-tab operating instructions -->
                    <TextBlock Text="{DynamicResource L10n_Guide_TabsTitle}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,16" LineHeight="21">
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Tab1Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_Tab1Rest}" /><LineBreak />
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Tab2Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_Tab2Rest}" /><LineBreak />
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Tab3Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_Tab3Rest}" /><LineBreak />
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Tab4Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_Tab4Rest}" /><LineBreak />
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Tab5Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_Tab5Rest}" />
                    </TextBlock>

                    <!-- Architecture diagram: fit-width by default, zoomable + pannable -->
                    <Border CornerRadius="14" Padding="10" Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1" Margin="0,0,0,20">
                        <Grid>
                            <ScrollViewer x:Name="DiagramScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="Diagram_PreviewMouseWheel">
                                <Grid x:Name="DiagramHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Cursor="SizeAll"
                                      MouseLeftButtonDown="Diagram_MouseLeftButtonDown"
                                      MouseMove="Diagram_MouseMove"
                                      MouseLeftButtonUp="Diagram_MouseLeftButtonUp"
                                      MouseLeave="Diagram_MouseLeave">
                                    <Image x:Name="ArchImage"
                                           Source="Assets/adam-codexhub-architecture.png"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="2" />
                                </Grid>
                            </ScrollViewer>

                            <!-- Zoom toolbar -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0">
                                <Button Content="−"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="15"
                                        Click="ZoomOut_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ZoomOutTip}"
                                        automation:AutomationProperties.Name="Zoom out" />
                                <Button Content="+"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="15"
                                        Click="ZoomIn_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ZoomInTip}"
                                        automation:AutomationProperties.Name="Zoom in" />
                                <Button Content="1:1"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="12"
                                        Click="ZoomReset_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ResetTip}"
                                        automation:AutomationProperties.Name="Reset zoom to 100 percent" />
                                <Button Content="{DynamicResource L10n_Guide_FitLabel}"
                                        Height="26" MinHeight="0" Padding="10,0"
                                        FontSize="12"
                                        Click="ZoomFit_Click"
                                        ToolTip="{DynamicResource L10n_Guide_FitTip}"
                                        automation:AutomationProperties.Name="Fit diagram to window width" />
                            </StackPanel>

                            <!-- Current zoom percentage -->
                            <TextBlock x:Name="ZoomLabel"
                                       Text="100%"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,6,4"
                                       Foreground="{StaticResource BrushMuted}"
                                       FontSize="11" />
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,0,0,18" />

                    <!-- Step-by-step -->
                    <TextBlock Text="{DynamicResource L10n_Guide_Sec2}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}" Margin="0,8,0,4" LineHeight="21">
                        <Run FontWeight="SemiBold" Text="{DynamicResource L10n_Guide_Sec2Lead}" /><Run Text=" " />
                        <Run Text="{DynamicResource L10n_Guide_Sec2Rest}" />
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,16" LineHeight="21">
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B2_1Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B2_1Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B2_2Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B2_2Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B2_3Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B2_3Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B2_4Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B2_4Rest}" />
                    </TextBlock>

                    <TextBlock Text="{DynamicResource L10n_Guide_Sec3}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B3_1Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B3_1Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B3_2Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B3_2Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B3_3Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B3_3Rest}" />
                    </TextBlock>

                    <TextBlock Text="{DynamicResource L10n_Guide_Sec4}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B4_1Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B4_1Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B4_2Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B4_2Rest}" /><LineBreak />
                        <Run Text="• " /><Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_B4_3Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_Guide_B4_3Rest}" />
                    </TextBlock>

                    <TextBlock Text="{DynamicResource L10n_Guide_Sec5}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        <Run Text="{DynamicResource L10n_Guide_S5Prefix}" /><Run Text=" " />
                        <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_S5Lead}" /><Run Text=" " />
                        <Run Text="{DynamicResource L10n_Guide_S5Rest}" />
                    </TextBlock>

                    <TextBlock Text="{DynamicResource L10n_Guide_Sec6}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        <Run Text="{DynamicResource L10n_Guide_S6Prefix}" /><Run Text=" " />
                        <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}" Text="{DynamicResource L10n_Guide_S6Lead}" /><Run Text=" " />
                        <Run Text="{DynamicResource L10n_Guide_S6Rest}" />
                    </TextBlock>

                    <TextBlock Text="{DynamicResource L10n_Guide_Sec7}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,4" LineHeight="21">
                        <Run Text="{DynamicResource L10n_Guide_S7Body}" />
                    </TextBlock>

                    <!-- Tips -->
                    <Border CornerRadius="12" Padding="16,13" Background="#14D89B2B"
                            BorderBrush="#59D89B2B" BorderThickness="1" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_Guide_TipsTitle}" Foreground="{StaticResource BrushGold}"
                                       FontWeight="Bold" FontSize="12" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" Margin="0,6,0,0" LineHeight="20">
                                <Run FontWeight="SemiBold" Text="1. " /><Run Text="{DynamicResource L10n_Guide_Tip1}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="2. " /><Run Text="{DynamicResource L10n_Guide_Tip2}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="3. " /><Run Text="{DynamicResource L10n_Guide_Tip3}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="4. " /><Run Text="{DynamicResource L10n_Guide_Tip4}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
