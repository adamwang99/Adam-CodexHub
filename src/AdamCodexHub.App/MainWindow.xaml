<Window x:Class="AdamCodexHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:mvvm="clr-namespace:AdamCodexHub.App.Mvvm"
        xmlns:vm="clr-namespace:AdamCodexHub.App.ViewModels"
        Title="Adam CodexHub"
        Style="{StaticResource AppWindow}"
        Width="1200"
        Height="780"
        MinWidth="1020"
        MinHeight="680"
        WindowStartupLocation="CenterScreen">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="7"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- Ambient glow layers painted behind content for the glass depth effect -->
        <RadialGradientBrush x:Key="AmbientGold" Center="0.95,0.0" GradientOrigin="0.95,0.0" RadiusX="1.0" RadiusY="1.0">
            <GradientStop Offset="0" Color="#4CD89B2B" />
            <GradientStop Offset="0.55" Color="#1CD89B2B" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientAqua" Center="0.0,1.05" GradientOrigin="0.0,1.05" RadiusX="1.0" RadiusY="1.0">
            <GradientStop Offset="0" Color="#3E2FD0C8" />
            <GradientStop Offset="0.55" Color="#182FD0C8" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientAmberWarm" Center="0.45,1.05" GradientOrigin="0.45,1.05" RadiusX="0.9" RadiusY="0.75">
            <GradientStop Offset="0" Color="#38E0A83C" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientMauve" Center="1.02,0.65" GradientOrigin="1.02,0.65" RadiusX="0.8" RadiusY="0.8">
            <GradientStop Offset="0" Color="#288A6FD8" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientRose" Center="0.12,0.5" GradientOrigin="0.12,0.5" RadiusX="0.75" RadiusY="0.7">
            <GradientStop Offset="0" Color="#26C77E8E" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>
        <RadialGradientBrush x:Key="AmbientTop" Center="0.6,-0.05" GradientOrigin="0.6,-0.05" RadiusX="1.1" RadiusY="0.7">
            <GradientStop Offset="0" Color="#30FFFFFF" />
            <GradientStop Offset="0.6" Color="#0AFFFFFF" />
            <GradientStop Offset="1" Color="#00000000" />
        </RadialGradientBrush>

        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Toolbar -->
                <Border Grid.Row="0" Style="{StaticResource CardBorder}" Padding="12" Margin="0,0,0,14">
                    <WrapPanel>
                        <Button Content="Codex Account"
                                Style="{StaticResource PrimaryButton}"
                                Command="{Binding RestoreAccountCommand}"
                                Margin="0,0,10,0"
                                automation:AutomationProperties.Name="Restore Codex Account">
                            <Button.ToolTip>
                                <TextBlock>Restore the default Codex sign-in account. Your per-provider API keys and models are kept.</TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <CheckBox Content="Open Desktop app"
                                  IsChecked="{Binding UseDesktopForAccount, Mode=TwoWay}"
                                  VerticalAlignment="Center"
                                  Margin="4,0,10,0"
                                  automation:AutomationProperties.Name="Open Codex Desktop for Codex Account">
                            <CheckBox.ToolTip>
                                <TextBlock>When ticked, Codex Account opens in the Desktop app. Unticked opens the Codex CLI instead.</TextBlock>
                            </CheckBox.ToolTip>
                        </CheckBox>
                        <Button Content="Refresh providers"
                                Command="{Binding RefreshCommand}"
                                Margin="0,0,10,0"
                                automation:AutomationProperties.Name="Refresh provider list">
                            <Button.ToolTip>
                                <TextBlock>Reload the provider list and refresh health, key and model state.</TextBlock>
                            </Button.ToolTip>
                        </Button>
                        <ToggleButton Content="Show all providers"
                                      IsChecked="{Binding ShowAllProviders, Mode=TwoWay}"
                                      automation:AutomationProperties.Name="Show or hide unconfigured providers">
                            <ToggleButton.ToolTip>
                                <TextBlock>When off, only Codex Account and providers you have set up are shown. Turn on to see every preset, including unused ones.</TextBlock>
                            </ToggleButton.ToolTip>
                        </ToggleButton>
                    </WrapPanel>
                </Border>

                <!-- Provider grid: floating logos, no enclosing card -->
                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         MouseDoubleClick="OnProviderDoubleClick"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         automation:AutomationProperties.Name="Provider selection grid">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Center" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <!-- No card: floating logo + text; cell wide enough that text never touches neighbors -->
                            <StackPanel Width="124" Margin="0,8" HorizontalAlignment="Center">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <StackPanel.ToolTip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TooltipDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="Double-click to activate with Codex." Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </StackPanel.ToolTip>
                                <Grid RenderTransformOrigin="0.5,0.5">
                                    <Grid.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Grid.RenderTransform>
                                    <Grid.Triggers>
                                        <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1.08" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1.08" Duration="0:0:0.14">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseOut" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                                     To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                                     To="1" Duration="0:0:0.22">
                                                        <DoubleAnimation.EasingFunction>
                                                            <QuadraticEase EasingMode="EaseIn" />
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Grid.Triggers>
                                    <!-- Logo disc: clear glass — transparent center, hairline rim, shadow cast by the logo itself -->
                                    <Border Width="80" Height="80" CornerRadius="21"
                                            HorizontalAlignment="Center"
                                            Background="Transparent"
                                            BorderBrush="#33FFFFFF"
                                            BorderThickness="1">
                                        <Grid Margin="9">
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Setter Property="Effect" Value="{StaticResource LogoShadow}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter Property="Effect" Value="{StaticResource LogoGlowHover}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <TextBlock Text="{Binding Initials}"
                                                       FontSize="26"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushAqua}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <Image Source="{Binding LogoSource}"
                                                   Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasLogo}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <!-- Status badge -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                            CornerRadius="7" Padding="6,2"
                                            Margin="0,-6,-6,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#73FFFFFF" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding StatusLabel}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushBackground}" />
                                    </Border>
                                    <!-- Target badge: W = Windows Desktop (blue), CLI = terminal (black) -->
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                            CornerRadius="7" Padding="5,2"
                                            Margin="-4,0,-2,-4"
                                            ToolTip="{Binding TargetTooltip}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource BrushAqua}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding TargetLabel}" Value="CLI">
                                                        <Setter Property="Background" Value="{StaticResource BrushBackground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding TargetLabel}"
                                                   FontSize="8"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource BrushWhite}" />
                                    </Border>
                                </Grid>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="SemiBold"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           Margin="0,16,0,3"
                                           TextWrapping="Wrap"
                                           TextAlignment="Center" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding Health}"
                                               Foreground="{StaticResource BrushAqua}"
                                               FontSize="10" />
                                    <TextBlock Text=" · "
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="10" />
                                    <TextBlock Text="{Binding EnabledModelCount, StringFormat={}{0} model(s)}"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="10" />
                                </StackPanel>
                                <TextBlock Text="{Binding KeyLabel}"
                                           Foreground="{StaticResource BrushMuted}"
                                           FontSize="10"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="Double-click a provider card to activate it with Codex. Codex Account returns to the default sign-in. For third-party providers, add an API key and verify a model first."
                           Foreground="{StaticResource BrushMuted}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderSetupViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Provider list column -->
                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel Grid.Row="0" Margin="6,0,6,10">
                            <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0" Padding="10,6" />
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,6" />
                        </WrapPanel>
                        <Grid Grid.Row="1" Margin="10,0,10,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="PROVIDER" Style="{StaticResource SectionLabel}" />
                            <TextBlock Grid.Column="1" Text="STATUS" Style="{StaticResource SectionLabel}">
                                <TextBlock.ToolTip>
                                    <TextBlock Text="Provider health. 'Unknown' means it has not been health-checked yet — test an API key or run a model probe to refresh it."
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </TextBlock.ToolTip>
                            </TextBlock>
                        </Grid>
                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <ListBox ItemsSource="{Binding Providers}"
                                     SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                     automation:AutomationProperties.Name="Provider profiles">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Id}" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Health}"
                                                       Foreground="{StaticResource BrushAqua}"
                                                       VerticalAlignment="Center">
                                                <TextBlock.ToolTip>
                                                    <TextBlock Text="{Binding HealthTooltip}"
                                                               TextWrapping="Wrap" MaxWidth="300" />
                                                </TextBlock.ToolTip>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">

                        <!-- PROFILE -->
                        <TextBlock Text="PROVIDER PROFILE" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Provider ID" Style="{StaticResource FieldLabel}" Margin="0,12,0,0" />
                        <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider ID" />
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider display name" />
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider base URL" />
                        <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}" />
                        <ComboBox Text="{Binding Adapter, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Margin="0,0,0,12"
                                  automation:AutomationProperties.Name="Provider adapter">
                            <ComboBoxItem Content="openai-compatible" />
                            <ComboBoxItem Content="openai-responses" />
                        </ComboBox>
                        <WrapPanel Margin="0,0,0,22">
                            <Button Content="Save provider" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="Enable / Disable" Command="{Binding ToggleProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="Choose logo" Command="{Binding ChooseLogoCommand}" Margin="0,0,8,8">
                                <Button.ToolTip>
                                    <TextBlock Text="Set a custom provider image (PNG, JPG or JPEG, under 512 KB). Without one, the provider shows a two-letter abbreviation."
                                               TextWrapping="Wrap" MaxWidth="300" />
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Delete provider" Style="{StaticResource DangerButton}" Command="{Binding DeleteProviderCommand}" Margin="0,0,0,8" />
                        </WrapPanel>

                        <!-- API KEYS -->
                        <TextBlock Text="API KEY POOL" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Paste an API key for the selected provider (encrypted per-provider)."
                                   Foreground="{StaticResource BrushMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Paste provider API key" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Add key" Style="{StaticResource PrimaryButton}" Command="{Binding AddKeyCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <Border Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding Keys}"
                                      SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      automation:AutomationProperties.Name="API key pool">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*" />
                                    <DataGridTextColumn Header="Masked" Binding="{Binding MaskedDisplay}" Width="*" />
                                    <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                                    <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="120" />
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Margin="0,0,0,22">
                            <Button Content="Test selected" Command="{Binding TestKeyCommand}" Margin="0,0,8,0">
                                <Button.ToolTip>
                                    <TextBlock>Test the currently selected API key against the provider.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Test all keys" Command="{Binding TestAllKeysCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all API keys">
                                <Button.ToolTip>
                                    <TextBlock>Test every stored API key for the selected provider in one go.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Enable / Disable" Command="{Binding ToggleKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Move up" Command="{Binding MoveUpKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Move down" Command="{Binding MoveDownKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete key" Style="{StaticResource DangerButton}" Command="{Binding DeleteKeyCommand}" />
                        </WrapPanel>

                        <!-- MODELS -->
                        <TextBlock Text="MODELS" Style="{StaticResource SectionLabel}" />
                        <WrapPanel Margin="0,8,0,10">
                            <Button Content="Scan models" Style="{StaticResource PrimaryButton}" Command="{Binding ScanModelsCommand}" Margin="0,0,8,0" />
                            <Button Content="Test all models" Command="{Binding TestAllModelsCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all models">
                                <Button.ToolTip>
                                    <TextBlock>Run compatibility probes on every model in this list.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        </WrapPanel>
                        <Border Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,10">
                            <DataGrid ItemsSource="{Binding Models}"
                                      SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      automation:AutomationProperties.Name="Discovered models">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Model" Binding="{Binding DisplayName}" Width="2.4*" />
                                    <DataGridTemplateColumn Header="Status" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding State}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Verified">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                    <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Score" Binding="{Binding CompatibilityScore}" Width="70" />
                                    <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
                                    <DataGridTemplateColumn Header="Actions" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Content="Test" Command="{Binding DataContext.TestModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,3" FontSize="11">
                                                        <Button.ToolTip>
                                                            <TextBlock>Run compatibility probes on this model (text, streaming, tool calling).</TextBlock>
                                                        </Button.ToolTip>
                                                    </Button>
                                                    <Button Content="Enable" Command="{Binding DataContext.ToggleModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11">
                                                        <Button.ToolTip>
                                                            <TextBlock>Enable / disable this model for Codex.</TextBlock>
                                                        </Button.ToolTip>
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>
                        <WrapPanel Margin="0,0,0,8">
                            <Button Content="Test compatibility" Command="{Binding TestModelCommand}" Margin="0,0,8,0" />
                            <Button Content="Enable / Disable" Command="{Binding ToggleModelCommand}" />
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="380" />
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="PROJECT &amp; TARGET" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Project directory" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
                        <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" automation:AutomationProperties.Name="Project directory" />
                        <TextBlock Text="Target provider" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Providers}"
                                  SelectedItem="{Binding SelectedTargetProvider, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  Margin="0,0,0,16"
                                  automation:AutomationProperties.Name="Target provider" />
                        <Button Content="Refresh project state" Command="{Binding RefreshProjectCommand}" Margin="0,0,0,8" />
                        <Button Content="Prepare provider handoff" Style="{StaticResource PrimaryButton}" Command="{Binding PrepareSwitchCommand}" />
                        <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0">
                            <TextBlock Text="{Binding RevisionSummary}" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Continuation instruction" Style="{StaticResource SectionLabel}" />
                        <TextBox Grid.Row="1"
                                 Text="{Binding ContinuationInstruction}"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,10,0,0"
                                 automation:AutomationProperties.Name="Continuation instruction" />
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LOCAL GATEWAY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GatewayStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,10,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Start / Stop" Command="{Binding ToggleGatewayCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CODEX CONFIG" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CodexStatus}" FontSize="15" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore last good" Command="{Binding RestoreConfigCommand}" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <Border Margin="0,0,0,14">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="PROVIDER STARTUP WARNINGS" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushGold}" />
                        <TextBlock Text="{Binding ProviderWarnings}" FontSize="13" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushCream}" />
                    </StackPanel>
                </Border>
                <Button Content="Refresh diagnostics" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ENFORCED DEFAULTS" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="Loopback-only gateway" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,16,0,8" />
                        <CheckBox Content="Automatic key failover" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Auto-refresh stale sessions" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Prompt and response logging" Foreground="{StaticResource BrushMuted}" IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Ambient depth layers + shell -->
    <Grid ClipToBounds="True">
        <Rectangle Fill="{StaticResource AmbientGold}" />
        <Rectangle Fill="{StaticResource AmbientAqua}" />
        <Rectangle Fill="{StaticResource AmbientAmberWarm}" />
        <Rectangle Fill="{StaticResource AmbientMauve}" />
        <Rectangle Fill="{StaticResource AmbientRose}" />
        <Rectangle Fill="{StaticResource AmbientTop}" />
        <!-- Frosted milk veil: diffuses the glow so panels read as frosted glass, not raw color -->
        <Rectangle Fill="{StaticResource BrushGlassFill}" />

        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- ============ Title bar (macOS traffic lights + app identity) ============ -->
            <Border Grid.Row="0" CornerRadius="12,12,0,0"
                    Background="#4D0D0D0D"
                    BorderBrush="{StaticResource BrushGlassRim}"
                    BorderThickness="1,1,1,0"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                    MouseLeftButtonUp="TitleBar_MouseLeftButtonUp">
                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Traffic lights -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource TrafficLightButton}"
                                Tag="close"
                                Background="#FF5F57"
                                Click="Close_Click"
                                Margin="0,0,8,0"
                                automation:AutomationProperties.Name="Close window" />
                        <Button Style="{StaticResource TrafficLightButton}"
                                Tag="min"
                                Background="#FEBC2E"
                                Click="Minimize_Click"
                                Margin="0,0,8,0"
                                automation:AutomationProperties.Name="Minimize window" />
                        <Button x:Name="MaximizeButton"
                                Style="{StaticResource TrafficLightButton}"
                                Tag="max"
                                Background="#28C840"
                                Click="MaximizeRestore_Click"
                                automation:AutomationProperties.Name="Maximize or restore window" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Border Width="24" Height="24" CornerRadius="7"
                                Background="#14FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                            <Image Source="Assets/adam-codexhub-logo.png" Stretch="Uniform" Margin="4" />
                        </Border>
                        <TextBlock Text="Adam CodexHub" FontWeight="SemiBold" FontSize="13"
                                   VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBlock Text="control hub" Foreground="{StaticResource BrushMuted}" FontSize="11"
                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>

                    <!-- Right: active provider + gateway -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border CornerRadius="8" Padding="10,4" Margin="0,0,8,0"
                                Background="#12FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                            <TextBlock VerticalAlignment="Center">
                                <Run Text="Active: " Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                <Run Text="{Binding ActiveProvider, Mode=OneWay}" FontWeight="SemiBold" FontSize="11" />
                            </TextBlock>
                        </Border>
                        <Border CornerRadius="8" Padding="10,4"
                                Background="#12FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                            <TextBlock Text="{Binding GatewayStatus}" Foreground="{StaticResource BrushAqua}" FontSize="11" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Body: sidebar + content ============ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="216" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Margin="0,10,0,0"
                        Background="{StaticResource BrushSidebar}"
                        BorderBrush="{StaticResource BrushGlassRim}"
                        BorderThickness="1,1,1,0"
                        CornerRadius="12,0,0,0"
                        Padding="10,18,10,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="CONTROL" Style="{StaticResource SectionLabel}" Margin="12,0,0,12" />

                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Pages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="3" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Active indicator -->
                                        <Border Grid.Column="0" CornerRadius="2" Margin="0,6"
                                                HorizontalAlignment="Center" VerticalAlignment="Stretch" Width="3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border Grid.Column="1" CornerRadius="{StaticResource PillRadius}" Padding="12,9" Margin="4,0,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="Transparent" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushSidebarActive}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Button Padding="0"
                                                    Background="Transparent"
                                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource NavButton}">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <TextBlock Text="{Binding Title}" FontSize="13" />
                                            </Button>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel Grid.Row="2" Margin="12,0,12,6">
                            <!-- About / Guide: two separate glass buttons -->
                            <StackPanel Orientation="Horizontal" Margin="2,0,0,10">
                                <Button Content="About" Click="About_Click" Padding="14,7"
                                        automation:AutomationProperties.Name="About Adam CodexHub">
                                    <Button.ToolTip>
                                        <TextBlock Text="About Adam CodexHub — built for research &amp; learning, free forever." />
                                    </Button.ToolTip>
                                </Button>
                                <Button Content="Guide" Click="Guide_Click" Padding="14,7" Margin="8,0,0,0"
                                        automation:AutomationProperties.Name="Open the usage guide">
                                    <Button.ToolTip>
                                        <TextBlock Text="Detailed usage guide with the architecture diagram." />
                                    </Button.ToolTip>
                                </Button>
                            </StackPanel>
                            <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,0,0,12" />
                            <TextBlock Text="ADAM DUNG AI" Foreground="{StaticResource BrushGold}" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content -->
                <Grid Grid.Column="1" Margin="22,12,16,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPage.Title}" Style="{StaticResource PageHeading}" />
                            <TextBlock Text="{Binding CurrentPage.Subtitle}" Margin="0,5,0,16" FontSize="13" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Refresh all" Command="{Binding RefreshCommand}" VerticalAlignment="Top" Padding="14,8" />
                    </Grid>

                    <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Margin="0,0,0,12">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>

                    <Border Grid.Row="2" Background="#14E66A6A" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12,9" Margin="0,0,0,12">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ErrorMessage}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                    </Border>

                    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ContentControl Content="{Binding CurrentPage}" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <Border Background="#14E66A6A" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding CurrentPage.ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{Binding CurrentPage.StatusMessage}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- ============ Status bar ============ -->
            <Border Grid.Row="2" Margin="0,10,0,0"
                    CornerRadius="0,0,12,12"
                    Background="#4D0D0D0D"
                    BorderBrush="{StaticResource BrushGlassRim}"
                    BorderThickness="1,0,1,1">
                <Grid Margin="14,0">
                    <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11"
                               Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrushGold}"
                               FontSize="10" FontWeight="SemiBold" Text="ADAM CODEXHUB · LOCAL GATEWAY" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
