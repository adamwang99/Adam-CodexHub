<Window x:Class="AdamCodexHub.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource L10n_Guide_WindowTitle}"
        Style="{StaticResource AppWindow}"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n_Guide_WindowTitle}" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushCream}" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Subtitle}"
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click"
                        Style="{StaticResource NavButton}" Padding="10,6"
                        VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <StackPanel>

                    <!-- How it works in one picture -->
                    <TextBlock Text="{DynamicResource L10n_Guide_Sec1}"
                               Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Sec1Body}"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                               Margin="0,7,0,12" LineHeight="20" />

                    <!-- Each application tab has its own screenshot and its own numbered legend. -->
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab1Title}" Style="{StaticResource SectionLabel}" />
                    <Image Source="Assets/guide-tab1-choose-provider.png" Stretch="Uniform" MaxWidth="900" Margin="0,8,0,6" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab1Legend}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" LineHeight="20" Margin="0,0,0,18" />

                    <TextBlock Text="{DynamicResource L10n_Guide_Tab2Title}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <Image Source="Assets/guide-tab2-providers.png" Stretch="Uniform" MaxWidth="900" Margin="0,8,0,6" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab2Legend}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" LineHeight="20" Margin="0,0,0,18" />

                    <TextBlock Text="{DynamicResource L10n_Guide_Tab3Title}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <Image Source="Assets/guide-tab3-sessions.png" Stretch="Uniform" MaxWidth="900" Margin="0,8,0,6" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab3Legend}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" LineHeight="20" Margin="0,0,0,18" />

                    <TextBlock Text="{DynamicResource L10n_Guide_Tab4Title}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <Image Source="Assets/guide-tab4-diagnostics.png" Stretch="Uniform" MaxWidth="900" Margin="0,8,0,6" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab4Legend}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" LineHeight="20" Margin="0,0,0,18" />

                    <TextBlock Text="{DynamicResource L10n_Guide_Tab5Title}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <Image Source="Assets/guide-tab5-settings.png" Stretch="Uniform" MaxWidth="900" Margin="0,8,0,6" />
                    <TextBlock Text="{DynamicResource L10n_Guide_Tab5Legend}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" LineHeight="20" Margin="0,0,0,18" />

                    <!-- Architecture diagram: fit-width by default, zoomable + pannable -->
                    <Border CornerRadius="14" Padding="10" Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1" Margin="0,0,0,20">
                        <Grid>
                            <ScrollViewer x:Name="DiagramScroller"
                                          HorizontalScrollBarVisibility="Auto"
                                          VerticalScrollBarVisibility="Disabled"
                                          PreviewMouseWheel="Diagram_PreviewMouseWheel">
                                <Grid x:Name="DiagramHost"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Top"
                                      Cursor="SizeAll"
                                      MouseLeftButtonDown="Diagram_MouseLeftButtonDown"
                                      MouseMove="Diagram_MouseMove"
                                      MouseLeftButtonUp="Diagram_MouseLeftButtonUp"
                                      MouseLeave="Diagram_MouseLeave">
                                    <Image x:Name="ArchImage"
                                           Source="Assets/adam-codexhub-architecture.png"
                                           Stretch="Fill"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           Margin="2" />
                                </Grid>
                            </ScrollViewer>

                            <!-- Zoom toolbar -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,4,4,0">
                                <Button Content="−"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="15"
                                        Click="ZoomOut_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ZoomOutTip}"
                                        automation:AutomationProperties.Name="Zoom out" />
                                <Button Content="+"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="15"
                                        Click="ZoomIn_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ZoomInTip}"
                                        automation:AutomationProperties.Name="Zoom in" />
                                <Button Content="1:1"
                                        Height="26" MinHeight="0" Padding="10,0" Margin="0,0,6,0"
                                        FontSize="12"
                                        Click="ZoomReset_Click"
                                        ToolTip="{DynamicResource L10n_Guide_ResetTip}"
                                        automation:AutomationProperties.Name="Reset zoom to 100 percent" />
                                <Button Content="{DynamicResource L10n_Guide_FitLabel}"
                                        Height="26" MinHeight="0" Padding="10,0"
                                        FontSize="12"
                                        Click="ZoomFit_Click"
                                        ToolTip="{DynamicResource L10n_Guide_FitTip}"
                                        automation:AutomationProperties.Name="Fit diagram to window width" />
                            </StackPanel>

                            <!-- Current zoom percentage -->
                            <TextBlock x:Name="ZoomLabel"
                                       Text="100%"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Bottom"
                                       Margin="0,0,6,4"
                                       Foreground="{StaticResource BrushMuted}"
                                       FontSize="11" />
                        </Grid>
                    </Border>

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,0,0,18" />

                    <!-- Shared operating notes are explained in tab 1 above. -->

                    <!-- Architecture diagram: fit-width by default, zoomable + pannable -->
                    <Border CornerRadius="12" Padding="16,13" Background="#14D89B2B"
                            BorderBrush="#59D89B2B" BorderThickness="1" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_Guide_TipsTitle}" Foreground="{StaticResource BrushGold}"
                                       FontWeight="Bold" FontSize="12" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" Margin="0,6,0,0" LineHeight="20">
                                <Run FontWeight="SemiBold" Text="1. " /><Run Text="{DynamicResource L10n_Guide_Tip1}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="2. " /><Run Text="{DynamicResource L10n_Guide_Tip2}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="3. " /><Run Text="{DynamicResource L10n_Guide_Tip3}" /><LineBreak />
                                <Run FontWeight="SemiBold" Text="4. " /><Run Text="{DynamicResource L10n_Guide_Tip4}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
