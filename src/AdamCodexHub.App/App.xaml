<Application x:Class="AdamCodexHub.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AdamCodexHub.App.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Active UI language dictionary (EN default). Swapped at runtime by App.ApplyLanguage. -->
                <ResourceDictionary Source="Resources/Locales/Locale.EN.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <!-- ============ Brand palette (unchanged) ============ -->
        <Color x:Key="ColorBackground">#111111</Color>
        <Color x:Key="ColorPanel">#141414</Color>
        <Color x:Key="ColorCard">#181818</Color>
        <Color x:Key="ColorCardHover">#202020</Color>
        <Color x:Key="ColorGold">#D89B2B</Color>
        <Color x:Key="ColorGoldHover">#E5AA3E</Color>
        <Color x:Key="ColorCream">#F8F4E8</Color>
        <Color x:Key="ColorWhite">#FFFFFF</Color>
        <Color x:Key="ColorAqua">#2FD0C8</Color>
        <Color x:Key="ColorMuted">#C4C4C4</Color>
        <Color x:Key="ColorBorder">#303030</Color>
        <Color x:Key="ColorDanger">#E66A6A</Color>
        <Color x:Key="ColorDangerSurface">#2A1717</Color>
        <Color x:Key="ColorWarningSurface">#2A2417</Color>

        <!-- ============ Glass surface palette (alpha over charcoal) ============ -->
        <Color x:Key="ColorGlassTop">#2E000000</Color>
        <Color x:Key="ColorGlassMid">#1A000000</Color>
        <Color x:Key="ColorGlassBottom">#3D0A0A0A</Color>
        <Color x:Key="ColorHairline">#26FFFFFF</Color>
        <Color x:Key="ColorHairlineSoft">#14FFFFFF</Color>
        <Color x:Key="ColorHairlineStrong">#40FFFFFF</Color>
        <Color x:Key="ColorAmbientGold">#38D89B2B</Color>
        <Color x:Key="ColorAmbientAqua">#2E2FD0C8</Color>
        <Color x:Key="ColorAmbientAmberWarm">#3BE0A83C</Color>
        <Color x:Key="ColorAmbientMauve">#2E8A6FD8</Color>
        <Color x:Key="ColorSidebar">#73111111</Color>
        <Color x:Key="ColorSidebarHover">#26FFFFFF</Color>
        <Color x:Key="ColorSidebarActive">#59D89B2B</Color>
        <Color x:Key="ColorContentGlass">#A60E0E0E</Color>
        <Color x:Key="ColorCardGlass">#590E0E0E</Color>
        <Color x:Key="ColorCardGlassStrong">#66161616</Color>
        <Color x:Key="ColorScrimTop">#66000000</Color>
        <Color x:Key="ColorSpecularTop">#5CFFFFFF</Color>
        <Color x:Key="ColorSpecularArc">#33FFFFFF</Color>
        <Color x:Key="ColorMilk">#0FFFFFFF</Color>
        <Color x:Key="ColorMilkTop">#1CFFFFFF</Color>

        <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
        <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}" />
        <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
        <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
        <SolidColorBrush x:Key="BrushGold" Color="{StaticResource ColorGold}" />
        <SolidColorBrush x:Key="BrushGoldHover" Color="{StaticResource ColorGoldHover}" />
        <SolidColorBrush x:Key="BrushCream" Color="{StaticResource ColorCream}" />
        <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColorWhite}" />
        <SolidColorBrush x:Key="BrushAqua" Color="{StaticResource ColorAqua}" />
        <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
        <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
        <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
        <SolidColorBrush x:Key="BrushDangerSurface" Color="{StaticResource ColorDangerSurface}" />
        <SolidColorBrush x:Key="BrushWarningSurface" Color="{StaticResource ColorWarningSurface}" />

        <SolidColorBrush x:Key="BrushHairline" Color="{StaticResource ColorHairline}" />
        <SolidColorBrush x:Key="BrushHairlineSoft" Color="{StaticResource ColorHairlineSoft}" />
        <SolidColorBrush x:Key="BrushHairlineStrong" Color="{StaticResource ColorHairlineStrong}" />
        <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
        <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}" />
        <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource ColorSidebarActive}" />
        <SolidColorBrush x:Key="BrushCardGlass" Color="{StaticResource ColorCardGlass}" />
        <SolidColorBrush x:Key="BrushCardGlassStrong" Color="{StaticResource ColorCardGlassStrong}" />
        <SolidColorBrush x:Key="BrushMilk" Color="{StaticResource ColorMilk}" />

        <!-- Top specular "light lip" — the bright arc along the top edge of glass panels -->
        <LinearGradientBrush x:Key="BrushSpecularTop" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#66FFFFFF" />
            <GradientStop Offset="0.45" Color="#2EFFFFFF" />
            <GradientStop Offset="1.0" Color="#00FFFFFF" />
        </LinearGradientBrush>

        <!-- Frosted milk tint that makes panels read as glass over the ambient glow -->
        <LinearGradientBrush x:Key="BrushGlassFill" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#1AFFFFFF" />
            <GradientStop Offset="0.08" Color="#0DFFFFFF" />
            <GradientStop Offset="0.5" Color="#00000000" />
            <GradientStop Offset="1.0" Color="#12000000" />
        </LinearGradientBrush>

        <!-- Frosted glass surface: white-milk translucency (not dark) so tinted backdrop bleeds through like real glass -->
        <LinearGradientBrush x:Key="BrushGlassSurface" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#59FFFFFF" />
            <GradientStop Offset="0.3" Color="#2EFFFFFF" />
            <GradientStop Offset="0.7" Color="#1AFFFFFF" />
            <GradientStop Offset="1.0" Color="#33FFFFFF" />
        </LinearGradientBrush>

        <!-- Asymmetric glass rim: bright on top where light hits, fading toward the bottom -->
        <LinearGradientBrush x:Key="BrushGlassRim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#C8FFFFFF" />
            <GradientStop Offset="0.08" Color="#59FFFFFF" />
            <GradientStop Offset="0.35" Color="#1EFFFFFF" />
            <GradientStop Offset="0.7" Color="#0CFFFFFF" />
            <GradientStop Offset="1.0" Color="#33FFFFFF" />
        </LinearGradientBrush>

        <!-- Drop shadow for floating glass panels -->
        <DropShadowEffect x:Key="GlassShadow" BlurRadius="24" ShadowDepth="10" Direction="270" Opacity="0.5" Color="#000000" />
        <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="16" ShadowDepth="6" Direction="270" Opacity="0.35" Color="#000000" />
        <!-- Warm amber halo for the selected glass card -->
        <DropShadowEffect x:Key="AmberHalo" BlurRadius="18" ShadowDepth="1" Direction="270" Opacity="0.4" Color="#D89B2B" />
        <!-- Soft resting shadow under buttons -->
        <DropShadowEffect x:Key="ButtonShadow" BlurRadius="9" ShadowDepth="3" Direction="270" Opacity="0.4" Color="#000000" />
        <!-- Amber glow when hovering an actionable control -->
        <DropShadowEffect x:Key="AmberGlowHover" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.45" Color="#D89B2B" />
        <!-- Provider logo: soft shadow cast beneath the logo shape onto the backdrop -->
        <DropShadowEffect x:Key="LogoShadow" BlurRadius="12" ShadowDepth="5" Direction="270" Opacity="0.6" Color="#000000" />
        <!-- Provider logo hover: warm amber glow lifts the logo -->
        <DropShadowEffect x:Key="LogoGlowHover" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.65" Color="#D89B2B" />

        <!-- Window backdrop: neutral cool charcoal (NOT pure black, NO brown) so translucent panels show color through the frost -->
        <LinearGradientBrush x:Key="BrushWindow" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0.0" Color="#FF1C1B26" />
            <GradientStop Offset="0.4" Color="#FF10101A" />
            <GradientStop Offset="0.75" Color="#FF141417" />
            <GradientStop Offset="1.0" Color="#FF1A1815" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushContentScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#FF110F19" />
            <GradientStop Offset="1.0" Color="#FF171513" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BrushTitleScrim" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0.0" Color="#2EFFFFFF" />
            <GradientStop Offset="0.5" Color="#0EFFFFFF" />
            <GradientStop Offset="1.0" Color="#00000000" />
        </LinearGradientBrush>

        <Thickness x:Key="ControlPadding">12,8</Thickness>
        <CornerRadius x:Key="ControlRadius">6</CornerRadius>
        <CornerRadius x:Key="CardRadius">8</CornerRadius>
        <CornerRadius x:Key="PanelRadius">18</CornerRadius>
        <CornerRadius x:Key="PillRadius">10</CornerRadius>
        <CornerRadius x:Key="WindowRadius">14</CornerRadius>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <local:BoolToWeightConverter x:Key="BoolToWeightConverter" />

        <!-- ============ Window chrome ============ -->
        <Style x:Key="AppWindow" TargetType="Window">
            <Setter Property="Background" Value="{StaticResource BrushWindow}" />
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            <Setter Property="UseLayoutRounding" Value="True" />
            <Setter Property="WindowStyle" Value="None" />
            <Setter Property="ResizeMode" Value="CanResize" />
        </Style>

        <!-- ============ Buttons ============ -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="0.5" Color="#1EFFFFFF" />
                        <GradientStop Offset="1" Color="#0EFFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="{StaticResource ControlPadding}" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <!-- Specular lip: light catching the top edge of the glass -->
                            <Border IsHitTestVisible="False"
                                    Height="1"
                                    VerticalAlignment="Top"
                                    Margin="3,0,3,0"
                                    CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#B3FFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1" />
                                <Setter Property="Effect" Value="{StaticResource AmberGlowHover}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                <Setter TargetName="Root" Property="BorderThickness" Value="1.5" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.92" />
                                <Setter Property="Effect" Value="{x:Null}" />
                                <Setter TargetName="Root" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#F2D89B2B" />
                        <GradientStop Offset="1" Color="#CCD89B2B" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="{StaticResource BrushBackground}" />
            <Setter Property="BorderBrush" Value="#B3D89B2B" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Effect" Value="{StaticResource AmberHalo}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushGold}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource BrushDangerSurface}" />
            <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
            <Setter Property="BorderBrush" Value="#59E66A6A" />
        </Style>

        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
        </Style>

        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Margin" Value="0,2" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="Transparent"
                                CornerRadius="{StaticResource PillRadius}"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.04" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.04" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <ContentPresenter HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1FFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- macOS traffic-light buttons -->
        <Style x:Key="TrafficLightButton" TargetType="Button">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Dot" Fill="{TemplateBinding Background}" Stroke="#40000000" StrokeThickness="1" />
                            <TextBlock x:Name="Glyph" Text=""
                                       FontSize="9" FontWeight="Bold"
                                       Foreground="#7A000000"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       FontFamily="Segoe UI Symbol"
                                       Visibility="Collapsed">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="close">
                                                <Setter Property="Text" Value="✕" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="min">
                                                <Setter Property="Text" Value="—" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Value="max">
                                                <Setter Property="Text" Value="❐" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Text & inputs ============ -->
        <Style x:Key="PageHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
        </Style>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushGold}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background" Value="{StaticResource BrushCardGlassStrong}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushCream}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BrushGold}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushGold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background" Value="{StaticResource BrushCardGlassStrong}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
            <Setter Property="CaretBrush" Value="{StaticResource BrushCream}" />
            <Setter Property="SelectionBrush" Value="{StaticResource BrushGold}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MinHeight" Value="34" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource BrushGold}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.5" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#38FFFFFF" />
                        <GradientStop Offset="0.5" Color="#1EFFFFFF" />
                        <GradientStop Offset="1" Color="#0EFFFFFF" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Effect" Value="{StaticResource ButtonShadow}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <Grid.Triggers>
                                <EventTrigger RoutedEvent="Mouse.MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1.05" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1.05" Duration="0:0:0.13">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseOut" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="Mouse.MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                             To="1" Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <QuadraticEase EasingMode="EaseIn" />
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Grid.Triggers>
                            <Border x:Name="Root"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{StaticResource ControlRadius}"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <Border IsHitTestVisible="False"
                                    Height="1"
                                    VerticalAlignment="Top"
                                    Margin="3,0,3,0"
                                    CornerRadius="2">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00FFFFFF" />
                                        <GradientStop Offset="0.5" Color="#B3FFFFFF" />
                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#4DFFFFFF" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                <Setter Property="Effect" Value="{StaticResource AmberGlowHover}" />
                            </Trigger>
                            <!-- Checked: unmistakable ON state — solid amber, dark text -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource BrushGold}" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushBackground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Effect" Value="{StaticResource AmberHalo}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource BrushSidebarActive}" />
                                <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background" Value="{StaticResource BrushCardGlassStrong}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="MaxDropDownHeight" Value="320" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid x:Name="Root">
                            <ToggleButton x:Name="DropDownToggle"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          BorderThickness="{TemplateBinding BorderThickness}"
                                          Foreground="{TemplateBinding Foreground}"
                                          Focusable="False"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ToggleBorder"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="{StaticResource ControlRadius}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0"
                                                                  Margin="10,0,8,0"
                                                                  HorizontalAlignment="Left"
                                                                  VerticalAlignment="Center"
                                                                  Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  ContentTemplateSelector="{Binding ItemTemplateSelector, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                                                  TextElement.Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Border Grid.Column="1"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="1,0,0,0">
                                                    <Path Width="9"
                                                          Height="5"
                                                          Data="M 0 0 L 4.5 4.5 L 9 0"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Stroke="{TemplateBinding Foreground}"
                                                          StrokeThickness="1.5" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="Background" Value="#B3FFFFFF" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <TextBox x:Name="PART_EditableTextBox"
                                     Margin="10,1,35,1"
                                     Padding="0"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{TemplateBinding Foreground}"
                                     CaretBrush="{TemplateBinding Foreground}"
                                     HorizontalContentAlignment="Left"
                                     VerticalContentAlignment="Center"
                                     IsReadOnly="{TemplateBinding IsReadOnly}"
                                     Visibility="Hidden" />

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   PlacementTarget="{Binding ElementName=Root}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, ElementName=Root}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        Margin="0,4,0,0"
                                        Background="{StaticResource BrushCard}"
                                        BorderBrush="{StaticResource BrushHairline}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource ControlRadius}">
                                    <ScrollViewer CanContentScroll="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEditable" Value="True">
                                <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="DropDownToggle" Property="BorderBrush" Value="{StaticResource BrushGold}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ Lists ============ -->
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="Transparent"
                                CornerRadius="{StaticResource PillRadius}"
                                Padding="{TemplateBinding Padding}"
                                Margin="0,1">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="#26D89B2B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineSoft}" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BrushHairlineSoft}" />
            <Setter Property="RowBackground" Value="Transparent" />
            <Setter Property="AlternatingRowBackground" Value="#0DFFFFFF" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="AutoGenerateColumns" Value="False" />
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairlineSoft}" />
            <Setter Property="Padding" Value="10,9" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource BrushSidebarActive}" />
                    <Setter Property="Foreground" Value="{StaticResource BrushWhite}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ============ Surfaces ============ -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BrushGlassSurface}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushGlassRim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
            <Setter Property="Padding" Value="18" />
            <Setter Property="Effect" Value="{StaticResource GlassShadowSoft}" />
        </Style>

        <Style x:Key="GlassPanelStrong" TargetType="Border" BasedOn="{StaticResource GlassPanel}">
            <Setter Property="Effect" Value="{StaticResource GlassShadow}" />
        </Style>

        <Style x:Key="CardBorder" TargetType="Border" BasedOn="{StaticResource GlassPanelStrong}">
            <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
            <Setter Property="Effect" Value="{StaticResource GlassShadowSoft}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{StaticResource BrushCream}" />
            <Setter Property="Background" Value="#E6161616" />
            <Setter Property="BorderBrush" Value="{StaticResource BrushHairline}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="HasDropShadow" Value="True" />
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Foreground" Value="{StaticResource BrushGold}" />
            <Setter Property="Background" Value="{StaticResource BrushHairlineSoft}" />
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
