<Window x:Class="AdamCodexHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:mvvm="clr-namespace:AdamCodexHub.App.Mvvm"
        xmlns:vm="clr-namespace:AdamCodexHub.App.ViewModels"
        Title="Adam CodexHub"
        Style="{StaticResource AppWindow}"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
                    <Button Content="Codex Account"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding RestoreAccountCommand}"
                            Margin="0,0,12,0"
                            automation:AutomationProperties.Name="Restore Codex Account">
                        <Button.ToolTip>
                            <TextBlock>Restore the default Codex sign-in account. Your per-provider API keys and models are kept.</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <CheckBox Content="Open Desktop app"
                              IsChecked="{Binding UseDesktopForAccount, Mode=TwoWay}"
                              VerticalAlignment="Center"
                              Margin="0,0,12,0"
                              Foreground="{StaticResource BrushCream}"
                              automation:AutomationProperties.Name="Open Codex Desktop for Codex Account">
                        <CheckBox.ToolTip>
                            <TextBlock>When ticked, Codex Account opens in the Desktop app. Unticked opens the Codex CLI instead.</TextBlock>
                        </CheckBox.ToolTip>
                    </CheckBox>
                    <Button Content="Refresh providers"
                            Command="{Binding RefreshCommand}"
                            Margin="0,0,12,0"
                            automation:AutomationProperties.Name="Refresh provider list">
                        <Button.ToolTip>
                            <TextBlock>Reload the provider list and refresh health, key and model state.</TextBlock>
                        </Button.ToolTip>
                    </Button>
                    <ToggleButton Content="Show all providers"
                                  IsChecked="{Binding ShowAllProviders, Mode=TwoWay}"
                                  automation:AutomationProperties.Name="Show or hide unconfigured providers">
                        <ToggleButton.ToolTip>
                            <TextBlock>When off, only Codex Account and providers you have set up are shown. Turn on to see every preset, including unused ones.</TextBlock>
                        </ToggleButton.ToolTip>
                    </ToggleButton>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Providers}"
                         SelectedItem="{Binding SelectedCard, Mode=TwoWay}"
                         MouseDoubleClick="OnProviderDoubleClick"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         automation:AutomationProperties.Name="Provider selection grid">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="4" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="6"
                                    Padding="14"
                                    CornerRadius="{StaticResource CardRadius}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource BrushCard}" />
                                        <Setter Property="BorderBrush" Value="{StaticResource BrushBorder}" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Setter Property="Opacity" Value="0.42" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                <Setter Property="Opacity" Value="1" />
                                                <Setter Property="BorderBrush" Value="{StaticResource BrushGold}" />
                                                <Setter Property="BorderThickness" Value="2" />
                                                <Setter Property="Background" Value="{StaticResource BrushCardHover}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Border.ToolTip>
                                    <StackPanel MaxWidth="280">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding TooltipDescription}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                        <TextBlock Text="Double-click to activate with Codex." Foreground="{StaticResource BrushMuted}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Border.ToolTip>
                                <StackPanel HorizontalAlignment="Center">
                                    <Grid>
                                        <Border Width="72" Height="72" CornerRadius="12"
                                                Background="{StaticResource BrushPanel}"
                                                HorizontalAlignment="Center">
                                            <Image Source="{Binding LogoSource}"
                                                   Stretch="Uniform"
                                                   Margin="10" />
                                        </Border>
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                CornerRadius="6" Padding="5,2"
                                                Margin="0,-6,-6,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource BrushBorder}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsValid}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource BrushGold}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding StatusLabel}"
                                                       FontSize="8"
                                                       FontWeight="Bold"
                                                       Foreground="{StaticResource BrushBackground}" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               FontSize="14"
                                               HorizontalAlignment="Center"
                                               Margin="0,12,0,2"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding Health}"
                                                   Foreground="{StaticResource BrushAqua}"
                                                   FontSize="11" />
                                        <TextBlock Text=" Â· "
                                                   Foreground="{StaticResource BrushMuted}"
                                                   FontSize="11" />
                                        <TextBlock Text="{Binding EnabledModelCount, StringFormat={}{0} model(s)}"
                                                   Foreground="{StaticResource BrushMuted}"
                                                   FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding KeyLabel}"
                                               Foreground="{StaticResource BrushMuted}"
                                               FontSize="10"
                                               HorizontalAlignment="Center"
                                               Margin="0,3,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="2"
                           Text="Double-click a provider card to activate it with Codex. Codex Account returns to the default sign-in. For third-party providers, add an API key and verify a model first."
                           Foreground="{StaticResource BrushMuted}"
                           TextWrapping="Wrap"
                           Margin="0,14,0,0" />
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProviderSetupViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Providers}"
                                 SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                                 automation:AutomationProperties.Name="Provider profiles">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Id}" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="{StaticResource BrushAqua}" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </Grid>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">

                        <!-- PROFIL U003 -->
                        <TextBlock Text="PROVIDER PROFILE" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Provider ID" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider ID" />
                        <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider display name" />
                        <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider base URL" />
                        <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}" />
                        <ComboBox Text="{Binding Adapter, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  Margin="0,0,0,12"
                                  automation:AutomationProperties.Name="Provider adapter">
                            <ComboBoxItem Content="openai-compatible" />
                            <ComboBoxItem Content="openai-responses" />
                        </ComboBox>
                        <WrapPanel Margin="0,0,0,20">
                            <Button Content="Save provider" Style="{StaticResource PrimaryButton}" Command="{Binding SaveProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="Enable / Disable" Command="{Binding ToggleProviderCommand}" Margin="0,0,8,8" />
                            <Button Content="Delete provider" Style="{StaticResource DangerButton}" Command="{Binding DeleteProviderCommand}" Margin="0,0,0,8" />
                        </WrapPanel>

                        <!-- API KEYS U003 -->
                        <TextBlock Text="API KEY POOL" Style="{StaticResource SectionLabel}" />
                        <TextBlock Text="Paste an API key for the selected provider (encrypted per-provider)." Foreground="{StaticResource BrushMuted}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding NewKey, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="Paste provider API key" Margin="0,0,8,0" />
                            <Button Grid.Column="1" Content="Add key" Style="{StaticResource PrimaryButton}" Command="{Binding AddKeyCommand}" VerticalAlignment="Center" />
                        </Grid>

                        <DataGrid ItemsSource="{Binding Keys}"
                                  SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  Margin="0,0,0,10"
                                  automation:AutomationProperties.Name="API key pool">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*" />
                                <DataGridTextColumn Header="Masked" Binding="{Binding MaskedDisplay}" Width="*" />
                                <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                                <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="130" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel Margin="0,0,0,20">
                            <Button Content="Test selected" Command="{Binding TestKeyCommand}" Margin="0,0,8,0">
                                <Button.ToolTip>
                                    <TextBlock>Test the currently selected API key against the provider.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Test all keys" Command="{Binding TestAllKeysCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all API keys">
                                <Button.ToolTip>
                                    <TextBlock>Test every stored API key for the selected provider in one go.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Enable / Disable" Command="{Binding ToggleKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Move up" Command="{Binding MoveUpKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Move down" Command="{Binding MoveDownKeyCommand}" Margin="0,0,8,0" />
                            <Button Content="Delete key" Style="{StaticResource DangerButton}" Command="{Binding DeleteKeyCommand}" />
                        </WrapPanel>

                        <!-- MODELS U003 -->
                        <TextBlock Text="MODELS" Style="{StaticResource SectionLabel}" />
                        <WrapPanel Margin="0,0,0,10">
                            <Button Content="Scan models" Style="{StaticResource PrimaryButton}" Command="{Binding ScanModelsCommand}" Margin="0,0,8,0" />
                            <Button Content="Test all models" Command="{Binding TestAllModelsCommand}" Margin="0,0,8,0" automation:AutomationProperties.Name="Test all models">
                                <Button.ToolTip>
                                    <TextBlock>Run compatibility probes on every model in this list.</TextBlock>
                                </Button.ToolTip>
                            </Button>
                            <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                        </WrapPanel>
                        <DataGrid ItemsSource="{Binding Models}"
                                  SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  Margin="0,0,0,10"
                                  automation:AutomationProperties.Name="Discovered models">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Model" Binding="{Binding DisplayName}" Width="2.4*" />
                                <DataGridTemplateColumn Header="Status" Width="90">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding State}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource BrushMuted}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding State}" Value="Enabled">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Verified">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushAqua}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding State}" Value="Failed">
                                                                <Setter Property="Foreground" Value="{StaticResource BrushDanger}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Score" Binding="{Binding CompatibilityScore}" Width="70" />
                                <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="80" />
                                <DataGridTemplateColumn Header="Actions" Width="150">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="Test" Command="{Binding DataContext.TestModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Margin="0,0,6,0" Padding="8,3" FontSize="11">
                                                    <Button.ToolTip>
                                                        <TextBlock>Run compatibility probes on this model (text, streaming, tool calling).</TextBlock>
                                                    </Button.ToolTip>
                                                </Button>
                                                <Button Content="Enable" Command="{Binding DataContext.ToggleModelCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" Padding="8,3" FontSize="11">
                                                    <Button.ToolTip>
                                                        <TextBlock>Enable / disable this model for Codex.</TextBlock>
                                                    </Button.ToolTip>
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <WrapPanel>
                            <Button Content="Test compatibility" Command="{Binding TestModelCommand}" Margin="0,0,8,0" />
                            <Button Content="Enable / Disable" Command="{Binding ToggleModelCommand}" />
                        </WrapPanel>

                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Project directory" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" automation:AutomationProperties.Name="Project directory" />
                    <TextBlock Text="Target provider" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedTargetProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,14"
                              automation:AutomationProperties.Name="Target provider" />
                    <Button Content="Refresh project state" Command="{Binding RefreshProjectCommand}" Margin="0,0,0,8" />
                    <Button Content="Prepare provider handoff" Style="{StaticResource PrimaryButton}" Command="{Binding PrepareSwitchCommand}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <TextBlock Text="{Binding RevisionSummary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Continuation instruction" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContinuationInstruction}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="360"
                             automation:AutomationProperties.Name="Continuation instruction" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LOCAL GATEWAY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GatewayStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Start / Stop" Command="{Binding ToggleGatewayCommand}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CODEX CONFIG" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CodexStatus}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore last good" Command="{Binding RestoreConfigCommand}" />
                    </Grid>
                </Border>
                <Border Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource CardBorder}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ProviderWarnings}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="PROVIDER STARTUP WARNINGS" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushGold}" />
                        <TextBlock Text="{Binding ProviderWarnings}" FontSize="13" Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{StaticResource BrushCream}" />
                    </StackPanel>
                </Border>
                <Button Content="Refresh diagnostics" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ENFORCED DEFAULTS" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="Loopback-only gateway" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,14,0,8" />
                        <CheckBox Content="Automatic key failover" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Auto-refresh stale sessions" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Prompt and response logging" Foreground="{StaticResource BrushMuted}" IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="Assets/adam-codexhub-logo.png" Width="154" HorizontalAlignment="Left" Stretch="Uniform">
                    <Image.ToolTip>
                        <TextBlock>Adam CodexHub â€” control hub for switching Codex between AI providers.
Double-click a provider in the grid to activate it.</TextBlock>
                    </Image.ToolTip>
                </Image>

                <TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="12"
                           Text="Select and double-click a provider below (or on the Choose Provider page) to activate it with Codex."
                           TextWrapping="Wrap" Margin="24,0" />

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ActiveProvider}" HorizontalAlignment="Right" FontWeight="SemiBold">
                        <TextBlock.ToolTip>
                            <TextBlock>Provider currently active for Codex.</TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>
                    <TextBlock Text="{Binding GatewayStatus}" HorizontalAlignment="Right" Foreground="{StaticResource BrushAqua}" FontSize="12" Margin="0,3,0,0">
                        <TextBlock.ToolTip>
                            <TextBlock>Status of the local Adam CodexHub gateway.</TextBlock>
                        </TextBlock.ToolTip>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,18">
                    <TextBlock Text="CONTROL" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="28,22,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushWhite}" />
                        <TextBlock Text="{Binding CurrentPage.Subtitle}" Margin="0,4,0,18" FontSize="13" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh all" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                </Grid>

                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Margin="0,0,0,12">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Border Grid.Row="2" Background="{StaticResource BrushDangerSurface}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12,9" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" />
                </ScrollViewer>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <Border Background="{StaticResource BrushDangerSurface}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentPage.ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding CurrentPage.StatusMessage}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrushGold}" FontSize="11" FontWeight="SemiBold" Text="ADAM DUNG AI" />
            </Grid>
        </Border>
    </Grid>
</Window>
