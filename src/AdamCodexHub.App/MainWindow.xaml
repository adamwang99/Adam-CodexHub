<Window x:Class="AdamCodexHub.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        xmlns:mvvm="clr-namespace:AdamCodexHub.App.Mvvm"
        xmlns:vm="clr-namespace:AdamCodexHub.App.ViewModels"
        Title="Adam CodexHub"
        Style="{StaticResource AppWindow}"
        Width="1180"
        Height="760"
        MinWidth="980"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:HomeViewModel}">
            <StackPanel>
                <Button Content="Refresh status"
                        Command="{Binding RefreshCommand}"
                        HorizontalAlignment="Left"
                        Margin="0,0,0,16"
                        automation:AutomationProperties.Name="Refresh overview status" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,8">
                        <StackPanel>
                            <TextBlock Text="ACTIVE PROVIDER" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding ProviderSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,0,0,8">
                        <StackPanel>
                            <TextBlock Text="MODEL READY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding ModelSummary}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,8,8,0">
                        <StackPanel>
                            <TextBlock Text="KEY POOL" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding KeySummary}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardBorder}" Margin="8,8,0,0">
                        <StackPanel>
                            <TextBlock Text="LOCAL GATEWAY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GatewaySummary}" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ProvidersViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <DockPanel Grid.Column="0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="New" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                        <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Items}"
                             SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                             automation:AutomationProperties.Name="Provider profiles">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Id}" Foreground="{StaticResource BrushMuted}" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Health}" Foreground="{StaticResource BrushAqua}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>

                <StackPanel Grid.Column="2" MaxWidth="620" HorizontalAlignment="Left">
                    <TextBlock Text="Provider ID" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider ID" />
                    <TextBlock Text="Display name" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProviderName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider display name" />
                    <TextBlock Text="Base URL" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding BaseUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" automation:AutomationProperties.Name="Provider base URL" />
                    <TextBlock Text="Adapter" Style="{StaticResource FieldLabel}" />
                    <ComboBox Text="{Binding Adapter, UpdateSourceTrigger=PropertyChanged}"
                              IsEditable="True"
                              Margin="0,0,0,18"
                              automation:AutomationProperties.Name="Provider adapter">
                        <ComboBoxItem Content="openai-compatible" />
                        <ComboBoxItem Content="openai-responses" />
                    </ComboBox>
                    <WrapPanel>
                        <Button Content="Save provider" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" Margin="0,0,8,8" />
                        <Button Content="Enable / Disable" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,8" />
                        <Button Content="Delete provider" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="0,0,0,8" />
                    </WrapPanel>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ApiKeysViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,14">
                    <TextBlock Text="Provider" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource BrushMuted}" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="260"
                              automation:AutomationProperties.Name="API key provider" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="8,0,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Label" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewLabel, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="API key label" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="API key" Style="{StaticResource FieldLabel}" />
                        <PasswordBox mvvm:PasswordBoxAssistant.BindPassword="True"
                                     mvvm:PasswordBoxAssistant.BoundPassword="{Binding NewSecret, Mode=TwoWay}"
                                     automation:AutomationProperties.Name="API key secret" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Priority" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding NewPriority, UpdateSourceTrigger=PropertyChanged}" automation:AutomationProperties.Name="API key priority" />
                    </StackPanel>
                    <Button Grid.Column="3"
                            Content="Add key"
                            Style="{StaticResource PrimaryButton}"
                            Command="{Binding AddCommand}"
                            VerticalAlignment="Bottom" />
                </Grid>

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Keys}"
                          SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                          automation:AutomationProperties.Name="API key pool">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Label" Binding="{Binding Label}" Width="2*" />
                        <DataGridTextColumn Header="Masked" Binding="{Binding MaskedDisplay}" Width="*" />
                        <DataGridTextColumn Header="Priority" Binding="{Binding Priority}" Width="90" />
                        <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="130" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                        <DataGridTextColumn Header="Cooldown until" Binding="{Binding CooldownUntil, StringFormat={}{0:t}}" Width="130" />
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="3" Margin="0,14,0,0">
                    <Button Content="Test selected" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                    <Button Content="Enable / Disable" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,0" />
                    <Button Content="Move up" Command="{Binding MoveUpCommand}" Margin="0,0,8,0" />
                    <Button Content="Move down" Command="{Binding MoveDownCommand}" Margin="0,0,8,0" />
                    <Button Content="Delete key" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" />
                </WrapPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:ModelsViewModel}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" Margin="0,0,0,14">
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="260"
                              Margin="0,0,8,0"
                              automation:AutomationProperties.Name="Model provider" />
                    <Button Content="Scan models" Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" />
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" />
                </WrapPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Models}"
                          SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                          automation:AutomationProperties.Name="Discovered models">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Model" Binding="{Binding DisplayName}" Width="3*" />
                        <DataGridTextColumn Header="State" Binding="{Binding State}" Width="120" />
                        <DataGridCheckBoxColumn Header="Enabled" Binding="{Binding Enabled}" Width="90" />
                        <DataGridTextColumn Header="Score" Binding="{Binding CompatibilityScore}" Width="80" />
                        <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeenAt, StringFormat={}{0:g}}" Width="160" />
                        <DataGridTextColumn Header="Last verified" Binding="{Binding LastVerifiedAt, StringFormat={}{0:g}}" Width="160" />
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="2" Margin="0,14,0,0">
                    <Button Content="Test compatibility" Command="{Binding TestCommand}" Margin="0,0,8,0" />
                    <Button Content="Enable / Disable" Command="{Binding ToggleEnabledCommand}" />
                </WrapPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SessionsViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Project directory" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ProjectPath, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,14" automation:AutomationProperties.Name="Project directory" />
                    <TextBlock Text="Target provider" Style="{StaticResource FieldLabel}" />
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedTargetProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Margin="0,0,0,14"
                              automation:AutomationProperties.Name="Target provider" />
                    <Button Content="Refresh project state" Command="{Binding RefreshProjectCommand}" Margin="0,0,0,8" />
                    <Button Content="Prepare provider handoff" Style="{StaticResource PrimaryButton}" Command="{Binding PrepareSwitchCommand}" />
                    <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                        <TextBlock Text="{Binding RevisionSummary}" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Continuation instruction" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding ContinuationInstruction}"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             MinHeight="360"
                             automation:AutomationProperties.Name="Continuation instruction" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="LOCAL GATEWAY" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding GatewayStatus}" FontSize="17" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Start / Stop" Command="{Binding ToggleGatewayCommand}" />
                    </Grid>
                </Border>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="CODEX CONFIG" Style="{StaticResource SectionLabel}" />
                            <TextBlock Text="{Binding CodexStatus}" FontSize="15" Margin="0,8,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Restore last good" Command="{Binding RestoreConfigCommand}" />
                    </Grid>
                </Border>
                <Button Content="Refresh diagnostics" Command="{Binding RefreshCommand}" HorizontalAlignment="Left" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="ENFORCED DEFAULTS" Style="{StaticResource SectionLabel}" />
                        <CheckBox Content="Loopback-only gateway" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,14,0,8" />
                        <CheckBox Content="Automatic key failover" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Auto-refresh stale sessions" Foreground="{StaticResource BrushMuted}" IsChecked="True" IsEnabled="False" Margin="0,0,0,8" />
                        <CheckBox Content="Prompt and response logging" Foreground="{StaticResource BrushMuted}" IsChecked="False" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="72" />
            <RowDefinition Height="*" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Image Source="Assets/adam-codexhub-logo.png" Width="154" HorizontalAlignment="Left" Stretch="Uniform" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Providers}"
                              SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Width="210"
                              Margin="0,0,8,0"
                              automation:AutomationProperties.Name="Active provider selection" />
                    <ComboBox ItemsSource="{Binding EnabledModels}"
                              SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Width="230"
                              Margin="0,0,8,0"
                              automation:AutomationProperties.Name="Enabled model selection" />
                    <Button Content="Activate" Style="{StaticResource PrimaryButton}" Command="{Binding ActivateCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding ActiveProvider}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GatewayStatus}" HorizontalAlignment="Right" Foreground="{StaticResource BrushAqua}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,0,1,0">
                <StackPanel Margin="12,18">
                    <TextBlock Text="CONTROL" Style="{StaticResource SectionLabel}" Margin="10,0,0,10" />
                    <ItemsControl ItemsSource="{Binding Pages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource NavButton}"
                                        Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"
                                        Content="{Binding Title}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1" Margin="28,22,28,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding CurrentPage.Title}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource BrushWhite}" />
                        <TextBlock Text="{Binding CurrentPage.Subtitle}" Margin="0,4,0,18" FontSize="13" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Refresh all" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                </Grid>

                <ProgressBar Grid.Row="1" Height="2" IsIndeterminate="True" Margin="0,0,0,12">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding CurrentPage.IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <Border Grid.Row="2" Background="{StaticResource BrushDangerSurface}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="12,9" Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ErrorMessage}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                </Border>

                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ContentControl Content="{Binding CurrentPage}" />
                </ScrollViewer>

                <StackPanel Grid.Row="4" Margin="0,12,0,0">
                    <Border Background="{StaticResource BrushDangerSurface}" BorderBrush="{StaticResource BrushDanger}" BorderThickness="1" CornerRadius="{StaticResource ControlRadius}" Padding="10,8" Margin="0,0,0,6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentPage.ErrorMessage}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding CurrentPage.ErrorMessage}" Foreground="{StaticResource BrushDanger}" TextWrapping="Wrap" />
                    </Border>
                    <TextBlock Text="{Binding CurrentPage.StatusMessage}" Foreground="{StaticResource BrushMuted}" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource BrushPanel}" BorderBrush="{StaticResource BrushBorder}" BorderThickness="0,1,0,0">
            <Grid Margin="14,0">
                <TextBlock VerticalAlignment="Center" Foreground="{StaticResource BrushMuted}" FontSize="11" Text="{Binding OperationMessage}" TextTrimming="CharacterEllipsis" />
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{StaticResource BrushGold}" FontSize="11" FontWeight="SemiBold" Text="ADAM DUNG AI" />
            </Grid>
        </Border>
    </Grid>
</Window>
