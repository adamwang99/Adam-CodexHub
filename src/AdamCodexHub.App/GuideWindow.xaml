<Window x:Class="AdamCodexHub.App.GuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adam CodexHub — Usage Guide"
        Style="{StaticResource AppWindow}"
        Width="980"
        Height="760"
        MinWidth="820"
        MinHeight="560"
        ResizeMode="CanResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Adam CodexHub — Usage Guide" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushCream}" />
                    <TextBlock Text="Every screen, step by step. Architecture diagram included."
                               Foreground="{StaticResource BrushMuted}" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Click="Close_Click"
                        Style="{StaticResource NavButton}" Padding="10,6"
                        VerticalAlignment="Top" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                <StackPanel>

                    <!-- How it works in one picture -->
                    <TextBlock Text="1 · HOW ADAM CODEXHUB FITS TOGETHER"
                               Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="The diagram below is generated from the repository itself: the WPF app and CLI talk to a clean Core; Providers wrap each AI service; Codex writes your config.toml safely; and a loopback Gateway lets Codex Desktop/CLI reach your chosen provider — keys never leave the machine in plaintext."
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                               Margin="0,7,0,12" LineHeight="20" />

                    <Border CornerRadius="14" Padding="10" Background="#0AFFFFFF"
                            BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1" Margin="0,0,0,20">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                            <Image Source="Assets/adam-codexhub-architecture.png"
                                   Stretch="Uniform" Margin="4" />
                        </ScrollViewer>
                    </Border>

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,0,0,18" />

                    <!-- Step-by-step -->
                    <TextBlock Text="2 · CHOOSE PROVIDER (HOME)"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}" Margin="0,8,0,4" LineHeight="21">
                        <Run FontWeight="SemiBold">Pick the provider you want to use with Codex.</Run> Each provider shows its logo, health (Healthy / Warning / Unknown), the number of enabled models and its key status.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,0,0,16" LineHeight="21">
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Add an API key</Run> if the provider has none — keys are encrypted with Windows DPAPI.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Double-click a provider</Run> to activate it with Codex (opens Desktop or CLI depending on the W / CLI badge).<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Codex Account</Run> restores the original sign-in — your keys and models are kept.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Show all providers</Run> toggles between providers you have configured and every built-in preset.
                    </TextBlock>

                    <TextBlock Text="3 · PROVIDERS"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">New / Refresh</Run> manage the provider list.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Status column</Run> — Unknown means the provider has not been health-checked yet; add a key and test to refresh it.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Choose logo</Run> picks a custom avatar for a provider (PNG/JPG up to 512 KB).
                    </TextBlock>

                    <TextBlock Text="4 · MODELS"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Scan models</Run> discovers what the provider exposes.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Test a model</Run> opens a live progress window — streaming, tool calling and structured JSON are probed in real time with the parameters each probe returned.<LineBreak/>
                        • <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">Enable / Disable</Run> decides what Codex may actually use. Only verified models should be enabled.
                    </TextBlock>

                    <TextBlock Text="5 · SESSIONS"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        Prepare a <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">provider-safe project handoff</Run>: point at a project directory, pick the target provider, and generate a continuation instruction — without editing Codex's internal session database.
                    </TextBlock>

                    <TextBlock Text="6 · DIAGNOSTICS"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,16" LineHeight="21">
                        Check the <Run FontWeight="SemiBold" Foreground="{StaticResource BrushCream}">local gateway</Run> and config recovery status: is the loopback proxy listening, is the token valid, were there rollbacks?
                    </TextBlock>

                    <TextBlock Text="7 · SETTINGS"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushMuted}" Margin="0,8,0,4" LineHeight="21">
                        Global preferences for how the hub behaves.
                    </TextBlock>

                    <!-- Tips -->
                    <Border CornerRadius="12" Padding="16,13" Background="#14D89B2B"
                            BorderBrush="#59D89B2B" BorderThickness="1" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="QUICK TIPS" Foreground="{StaticResource BrushGold}"
                                       FontWeight="Bold" FontSize="12" />
                            <TextBlock TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" Margin="0,6,0,0" LineHeight="20">
                                1. A provider can stay at <Run FontWeight="SemiBold">Unknown</Run> until you test a key or run a model probe — that is normal.<LineBreak/>
                                2. When a key hits a 429 or quota limit, the hub fails over to the next healthy key in that provider's pool (max 3 attempts).<LineBreak/>
                                3. Every config change is backed up first — if anything breaks, Codex Account mode restores your original configuration.<LineBreak/>
                                4. Free forever. You only pay your AI providers directly, never the hub.
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
