<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- System.Windows.Forms.NotifyIcon powers the tray icon (Show/Exit) without new packages. -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Real multi-size application icon (taskbar, alt-tab, explorer) — fixes the black blob. -->
    <ApplicationIcon>Assets\adam-codexhub.ico</ApplicationIcon>
    <Version>1.0.2</Version>
  </PropertyGroup>
  <ItemGroup>
    <!-- UseWindowsForms pulls framework global usings for System.Windows.Forms/System.Drawing that
         would make bare WPF identifiers (Application, MessageBox, Color...) ambiguous. The tray
         code imports them through explicit aliases instead. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <ProjectReference Include="..\AdamCodexHub.Core\AdamCodexHub.Core.csproj" />
    <ProjectReference Include="..\AdamCodexHub.Infrastructure\AdamCodexHub.Infrastructure.csproj" />
    <ProjectReference Include="..\AdamCodexHub.Providers\AdamCodexHub.Providers.csproj" />
    <ProjectReference Include="..\AdamCodexHub.Codex\AdamCodexHub.Codex.csproj" />
    <ProjectReference Include="..\AdamCodexHub.Gateway\AdamCodexHub.Gateway.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\adam-codexhub-logo.png" />
    <Resource Include="Assets\adam-codexhub.ico" />
    <Resource Include="Assets\adam-codexhub-architecture.png" />
    <Resource Include="Assets\guide-tab1-choose-provider.png" />
    <Resource Include="Assets\guide-tab2-providers.png" />
    <Resource Include="Assets\guide-tab3-sessions.png" />
    <Resource Include="Assets\guide-tab4-diagnostics.png" />
    <Resource Include="Assets\guide-tab5-settings.png" />
    <Resource Include="Assets\Fonts\Barlow-Regular.ttf" />
    <Resource Include="Assets\Fonts\Barlow-Medium.ttf" />
    <Resource Include="Assets\Fonts\Barlow-SemiBold.ttf" />
    <Resource Include="Assets\Fonts\Barlow-Bold.ttf" />
    <Resource Include="Assets\providers\anthropic.png" />
    <Resource Include="Assets\providers\codex-account.png" />
    <Resource Include="Assets\providers\deepseek.png" />
    <Resource Include="Assets\providers\fireworks.png" />
    <Resource Include="Assets\providers\gemini.png" />
