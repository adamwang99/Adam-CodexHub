{
  "schemaVersion": 1,
  "id": "openrouter",
  "name": "OpenRouter",
  "adapter": "openai-compatible",
  "baseUrl": "https://openrouter.ai/api/v1",
  "trustLevel": "verified",
  "auth": {
    "type": "bearer",
    "headerName": "Authorization"
  },
  "endpoints": {
    "models": "/models",
    "responses": "/responses",
    "chatCompletions": "/chat/completions"
  },
  "extraHeaders": {},
  "capabilities": [
    "text",
    "streaming",
    "tools"
  ],
  "notes": "Capabilities vary by routed model."
}