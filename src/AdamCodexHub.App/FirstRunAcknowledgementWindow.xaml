<Window x:Class="AdamCodexHub.App.FirstRunAcknowledgementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Adam CodexHub — Important"
        Style="{StaticResource AppWindow}"
        Width="650"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Border Padding="28">
        <StackPanel>
            <TextBlock Text="Important: How Provider Switching Works"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushWhite}" />

            <TextBlock Margin="0,16,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushCream}"
                       LineHeight="21">
                Adam CodexHub can use Codex with multiple AI providers. To avoid broken sessions,
                missing tools, provider mismatches and stale context, the app does not directly
                convert an existing chat session from one provider into another.
            </TextBlock>

            <Border Style="{StaticResource CardBorder}"
                    Margin="0,18,0,18">
                <StackPanel>
                    <TextBlock Text="When you switch providers:"
                               Foreground="{StaticResource BrushGold}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,8" />

                    <TextBlock Text="• current work state is saved automatically&#x0a;• an existing target-provider session is resumed when possible&#x0a;• otherwise a new session receives the latest project state&#x0a;• stale sessions are refreshed when you return&#x0a;• API-key rotation inside the same provider does not require a new session"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushCream}"
                               LineHeight="22" />
                </StackPanel>
            </Border>

            <TextBlock Text="Source of truth"
                       Foreground="{StaticResource BrushGold}"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,5,0,18"
                       Text="Current project files, Git state and synchronized project state take priority over old chat history."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource BrushCream}" />

            <CheckBox x:Name="AcknowledgementCheckBox"
                      Checked="AcknowledgementChanged"
                      Unchecked="AcknowledgementChanged"
                      Foreground="{StaticResource BrushCream}">
                <TextBlock Width="545"
                           TextWrapping="Wrap"
                           Text="I understand that each provider may use a separate session and that Adam CodexHub may automatically synchronize or refresh project state when switching or resuming sessions." />
            </CheckBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="ContinueButton"
                        Style="{StaticResource PrimaryButton}"
                        IsEnabled="False"
                        Click="Continue_Click"
                        Content="I Understand — Continue" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
