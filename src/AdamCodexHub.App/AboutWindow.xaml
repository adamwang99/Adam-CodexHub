<Window x:Class="AdamCodexHub.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Adam CodexHub"
        Style="{StaticResource AppWindow}"
        Width="600"
        Height="560"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Border Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="14" Background="#16FFFFFF"
                        BorderBrush="{StaticResource BrushGlassRim}" BorderThickness="1">
                    <Image Source="Assets/adam-codexhub-logo.png" Stretch="Uniform" Margin="9" />
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Adam CodexHub" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushCream}" />
                    <TextBlock Text="multi-provider control hub for Codex — free forever"
                               Foreground="{StaticResource BrushAqua}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Click="Close_Click"
                        Style="{StaticResource NavButton}" Padding="10,6"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="BUILT FOR RESEARCH &amp; LEARNING"
                               Style="{StaticResource SectionLabel}" />
                    <TextBlock Text="Adam CodexHub is an independent, open-source project (MIT) created for everyone who wants to understand how Codex can work with many AI providers — without breaking the official sign-in, without exposing keys, and without a paywall."
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,0" LineHeight="21" />

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,16" />

                    <TextBlock Text="A LEARNING PATH, NOT JUST A TOOL"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="1" Foreground="{StaticResource BrushBackground}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480">
                                <Run FontWeight="SemiBold">Explore providers.</Run> Open the hub and see every provider as a first-class citizen — presets, keys, health, models.
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="2" Foreground="{StaticResource BrushBackground}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480">
                                <Run FontWeight="SemiBold">Test before you trust.</Run> Run streaming, tool-calling and structured-output probes with a live progress window — learn what each model can really do.
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="3" Foreground="{StaticResource BrushBackground}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480">
                                <Run FontWeight="SemiBold">Read the source.</Run> Cleanly layered: App → Core → Providers → Codex → Gateway. Each layer teaches one idea (DPAPI, adapters, transactional config, loopback routing).
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="4" Foreground="{StaticResource BrushBackground}" FontWeight="Bold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" />
                            </Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480">
                                <Run FontWeight="SemiBold">Make it yours.</Run> MIT license — fork it, study it, and ship your own ideas freely.
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,16" />

                    <Border CornerRadius="12" Padding="16,13" Background="#14D89B2B"
                            BorderBrush="#59D89B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="FREE FOR LIFE" Foreground="{StaticResource BrushGold}"
                                       FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="No subscriptions, no trials, no token metering. Adam CodexHub is free forever — you only ever pay your own AI providers directly."
                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                                       Margin="0,5,0,0" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Open the guide" Click="OpenGuide_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
