<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ Day (warm cream) — brand palette, light surfaces ============ -->
    <Color x:Key="ColorBackground">#EAE4D8</Color>
    <Color x:Key="ColorPanel">#F1ECDF</Color>
    <Color x:Key="ColorCard">#FFFFFF</Color>
    <Color x:Key="ColorCardHover">#E2DAC8</Color>
    <Color x:Key="ColorGold">#A87905</Color>
    <Color x:Key="ColorGoldHover">#966D07</Color>
    <Color x:Key="ColorCream">#3A3226</Color>
    <Color x:Key="ColorWhite">#FFFFFF</Color>
    <Color x:Key="ColorAqua">#16857F</Color>
    <Color x:Key="ColorMuted">#332C22</Color>
    <Color x:Key="ColorBorder">#C6BBA2</Color>
    <Color x:Key="ColorDanger">#C0392B</Color>
    <Color x:Key="ColorDangerSurface">#FCEAE7</Color>
    <Color x:Key="ColorWarningSurface">#FCF4DE</Color>

    <Color x:Key="ColorGlassTop">#00FFFFFF</Color>
    <Color x:Key="ColorGlassMid">#00FFFFFF</Color>
    <Color x:Key="ColorGlassBottom">#0A000000</Color>
    <Color x:Key="ColorHairline">#3E000000</Color>
    <Color x:Key="ColorHairlineSoft">#1C000000</Color>
    <Color x:Key="ColorHairlineStrong">#4D000000</Color>
    <Color x:Key="ColorAmbientGold">#26B8860B</Color>
    <Color x:Key="ColorAmbientAqua">#221B9C96</Color>
    <Color x:Key="ColorAmbientAmberWarm">#2AC98F1B</Color>
    <Color x:Key="ColorAmbientMauve">#207A5FD0</Color>
    <Color x:Key="ColorSidebar">#E6F1EDE4</Color>
    <Color x:Key="ColorSidebarHover">#1A000000</Color>
    <Color x:Key="ColorSidebarActive">#33B8860B</Color>
    <Color x:Key="ColorContentGlass">#EFF7F4EC</Color>
    <Color x:Key="ColorCardGlass">#F2FFFFFF</Color>
    <Color x:Key="ColorCardGlassStrong">#FFFFFF</Color>
    <Color x:Key="ColorScrimTop">#17000000</Color>
    <Color x:Key="ColorSpecularTop">#59FFFFFF</Color>
    <Color x:Key="ColorSpecularArc">#26FFFFFF</Color>
    <Color x:Key="ColorMilk">#0A000000</Color>
    <Color x:Key="ColorMilkTop">#1C000000</Color>

    <!-- Text ramp (semantic) -->
    <Color x:Key="ColorTextHigh">#FA1E1813</Color>
    <Color x:Key="ColorTextMid">#D1241D18</Color>
    <Color x:Key="ColorTextLow">#B5241D18</Color>
    <!-- Overlay tints (inverted: black-tinted on light) -->
    <Color x:Key="ColorOverlayHover">#17000000</Color>
    <Color x:Key="ColorOverlayHoverStrong">#28000000</Color>
    <Color x:Key="ColorOverlayPressed">#3E000000</Color>
    <Color x:Key="ColorOverlayMilk">#0D000000</Color>
    <!-- Bespoke surfaces -->
    <Color x:Key="ColorSwitchTrack">#3E000000</Color>
    <Color x:Key="ColorSwitchThumb">#FFFFFF</Color>
    <Color x:Key="ColorBadgeGlass">#3E000000</Color>
    <Color x:Key="ColorTooltip">#FFFDFAF4</Color>
    <Color x:Key="ColorTitleBar">#E6FFFFFF</Color>
    <Color x:Key="ColorFlowTop">#F7FFFFFF</Color>
    <Color x:Key="ColorFlowMid">#F2FFFFFF</Color>
    <Color x:Key="ColorFlowBottom">#ECFFFFFF</Color>

    <SolidColorBrush x:Key="BrushBackground" Color="{StaticResource ColorBackground}" />
    <SolidColorBrush x:Key="BrushPanel" Color="{StaticResource ColorPanel}" />
    <SolidColorBrush x:Key="BrushCard" Color="{StaticResource ColorCard}" />
    <SolidColorBrush x:Key="BrushCardHover" Color="{StaticResource ColorCardHover}" />
    <SolidColorBrush x:Key="BrushGold" Color="{StaticResource ColorGold}" />
    <SolidColorBrush x:Key="BrushGoldHover" Color="{StaticResource ColorGoldHover}" />
    <SolidColorBrush x:Key="BrushCream" Color="{StaticResource ColorCream}" />
    <SolidColorBrush x:Key="BrushWhite" Color="{StaticResource ColorWhite}" />
    <SolidColorBrush x:Key="BrushAqua" Color="{StaticResource ColorAqua}" />
    <SolidColorBrush x:Key="BrushMuted" Color="{StaticResource ColorMuted}" />
    <SolidColorBrush x:Key="BrushBorder" Color="{StaticResource ColorBorder}" />
    <SolidColorBrush x:Key="BrushDanger" Color="{StaticResource ColorDanger}" />
    <SolidColorBrush x:Key="BrushDangerSurface" Color="{StaticResource ColorDangerSurface}" />
    <SolidColorBrush x:Key="BrushWarningSurface" Color="{StaticResource ColorWarningSurface}" />

    <SolidColorBrush x:Key="BrushTextHigh" Color="{StaticResource ColorTextHigh}" />
    <SolidColorBrush x:Key="BrushTextMid" Color="{StaticResource ColorTextMid}" />
    <SolidColorBrush x:Key="BrushTextLow" Color="{StaticResource ColorTextLow}" />
    <SolidColorBrush x:Key="BrushOverlayHover" Color="{StaticResource ColorOverlayHover}" />
    <SolidColorBrush x:Key="BrushOverlayHoverStrong" Color="{StaticResource ColorOverlayHoverStrong}" />
    <SolidColorBrush x:Key="BrushOverlayPressed" Color="{StaticResource ColorOverlayPressed}" />
    <SolidColorBrush x:Key="BrushOverlayMilk" Color="{StaticResource ColorOverlayMilk}" />
    <SolidColorBrush x:Key="BrushSwitchTrack" Color="{StaticResource ColorSwitchTrack}" />
    <SolidColorBrush x:Key="BrushSwitchThumb" Color="{StaticResource ColorSwitchThumb}" />
    <SolidColorBrush x:Key="BrushBadgeGlass" Color="{StaticResource ColorBadgeGlass}" />
    <SolidColorBrush x:Key="BrushTooltip" Color="{StaticResource ColorTooltip}" />
    <SolidColorBrush x:Key="BrushTitleBar" Color="{StaticResource ColorTitleBar}" />
    <SolidColorBrush x:Key="BrushFlowTop" Color="{StaticResource ColorFlowTop}" />
    <SolidColorBrush x:Key="BrushFlowMid" Color="{StaticResource ColorFlowMid}" />
    <SolidColorBrush x:Key="BrushFlowBottom" Color="{StaticResource ColorFlowBottom}" />

    <SolidColorBrush x:Key="BrushHairline" Color="{StaticResource ColorHairline}" />
    <SolidColorBrush x:Key="BrushHairlineSoft" Color="{StaticResource ColorHairlineSoft}" />
    <SolidColorBrush x:Key="BrushHairlineStrong" Color="{StaticResource ColorHairlineStrong}" />
    <SolidColorBrush x:Key="BrushSidebar" Color="{StaticResource ColorSidebar}" />
    <SolidColorBrush x:Key="BrushSidebarHover" Color="{StaticResource ColorSidebarHover}" />
    <SolidColorBrush x:Key="BrushSidebarActive" Color="{StaticResource ColorSidebarActive}" />
    <SolidColorBrush x:Key="BrushCardGlass" Color="{StaticResource ColorCardGlass}" />
    <SolidColorBrush x:Key="BrushCardGlassStrong" Color="{StaticResource ColorCardGlassStrong}" />
    <SolidColorBrush x:Key="BrushMilk" Color="{StaticResource ColorMilk}" />

    <LinearGradientBrush x:Key="BrushSpecularTop" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#33FFFFFF" />
        <GradientStop Offset="0.45" Color="#0DFFFFFF" />
        <GradientStop Offset="1.0" Color="#00FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassFill" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#0DFFFFFF" />
        <GradientStop Offset="0.5" Color="#00000000" />
        <GradientStop Offset="1.0" Color="#0A000000" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassSurface" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#F7FFFFFF" />
        <GradientStop Offset="0.35" Color="#F2FFFFFF" />
        <GradientStop Offset="0.7" Color="#ECFFFFFF" />
        <GradientStop Offset="1.0" Color="#F5FFFFFF" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrushGlassRim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#8CFFFFFF" />
        <GradientStop Offset="0.25" Color="#40000000" />
        <GradientStop Offset="0.7" Color="#17000000" />
        <GradientStop Offset="1.0" Color="#3E000000" />
    </LinearGradientBrush>

    <DropShadowEffect x:Key="GlassShadow" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.22" Color="#000000" />
    <DropShadowEffect x:Key="GlassShadowSoft" BlurRadius="16" ShadowDepth="4" Direction="270" Opacity="0.14" Color="#000000" />
    <DropShadowEffect x:Key="AmberHalo" BlurRadius="18" ShadowDepth="1" Direction="270" Opacity="0.3" Color="#A87905" />
    <DropShadowEffect x:Key="ButtonShadow" BlurRadius="9" ShadowDepth="3" Direction="270" Opacity="0.18" Color="#000000" />
    <DropShadowEffect x:Key="AmberGlowHover" BlurRadius="14" ShadowDepth="2" Direction="270" Opacity="0.35" Color="#A87905" />
    <DropShadowEffect x:Key="LogoShadow" BlurRadius="12" ShadowDepth="4" Direction="270" Opacity="0.4" Color="#9A9A9A" />
    <DropShadowEffect x:Key="LogoGlowHover" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#A87905" />
    <DropShadowEffect x:Key="LogoGlowActive" BlurRadius="16" ShadowDepth="0" Opacity="0.32" Color="#000000" />
    <SolidColorBrush x:Key="BrushLogoDisc" Color="#00FFFFFF" />
    <!-- Active disc (light): charcoal vignette, darkest at outer edge fading inward -> raised rounded look. -->
    <RadialGradientBrush x:Key="BrushActiveDisc" GradientOrigin="0.5,0.5" Center="0.5,0.5" RadiusX="0.55" RadiusY="0.55">
        <GradientStop Offset="0.0" Color="#14000000" />
        <GradientStop Offset="0.7" Color="#3E000000" />
        <GradientStop Offset="1.0" Color="#8A000000" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="BrushActiveDiscRim" Color="#73000000" />
    <DropShadowEffect x:Key="AquaGlowToggle" BlurRadius="9" ShadowDepth="0" Opacity="0.6" Color="#16857F" />

    <LinearGradientBrush x:Key="BrushWindow" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#FFF7F3EB" />
        <GradientStop Offset="0.45" Color="#FFF1ECE1" />
        <GradientStop Offset="0.8" Color="#FFEDE7D9" />
        <GradientStop Offset="1.0" Color="#FFE9E2D2" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushContentScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#FFF3EFE6" />
        <GradientStop Offset="1.0" Color="#FFE9E2D4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="BrushTitleScrim" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0.0" Color="#0DFFFFFF" />
        <GradientStop Offset="0.5" Color="#05000000" />
        <GradientStop Offset="1.0" Color="#00000000" />
    </LinearGradientBrush>
    <!-- ============ Model callability badges (latency-aware) ============ -->
    <!-- Green = callable, amber = slow but working, red = skipped/failed (light-theme values). -->
    <SolidColorBrush x:Key="BrushStatusCallable" Color="#16857F" />
    <SolidColorBrush x:Key="BrushStatusSlow" Color="#A87905" />
    <SolidColorBrush x:Key="BrushStatusSkip" Color="#C0392B" />
    <SolidColorBrush x:Key="BrushStatusUnknown" Color="#A99C82" />
</ResourceDictionary>
