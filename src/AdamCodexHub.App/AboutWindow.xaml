<Window x:Class="AdamCodexHub.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="{DynamicResource L10n_About_WindowTitle}"
        Style="{StaticResource AppWindow}"
        Width="640"
        Height="740"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True">

    <Border Padding="26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: the SAME frameless logo as the main window, same 70px -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Source="Assets/adam-codexhub-logo.png" Width="70" Height="70"
                       Stretch="Uniform" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality">
                    <Image.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Direction="270" Opacity="0.5" Color="#000000" />
                    </Image.Effect>
                </Image>
                <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Adam CodexHub" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource BrushCream}" />
                    <TextBlock Text="{DynamicResource L10n_About_Tagline}"
                               Foreground="{StaticResource BrushAqua}" FontSize="12" Margin="0,2,0,0" />
                </StackPanel>
                <Button Grid.Column="2" Content="✕" Click="Close_Click"
                        Style="{StaticResource NavButton}" Padding="10,6"
                        VerticalAlignment="Top" />
            </Grid>

            <!-- Body -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource L10n_About_CreatorTitle}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock Text="{DynamicResource L10n_About_CreatorBody}"
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,0" LineHeight="21" />

                    <TextBlock Text="{DynamicResource L10n_About_SecMission}"
                               Style="{StaticResource SectionLabel}" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource L10n_About_MissionBody}"
                               TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,0" LineHeight="21" />

                    <TextBlock Text="{DynamicResource L10n_About_UseTitle}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource L10n_About_UseBody}"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,0" LineHeight="20" />

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,16" />

                    <TextBlock Text="{DynamicResource L10n_About_SecPath}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <StackPanel Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"><TextBlock Text="1" Foreground="{StaticResource BrushBackground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480"><Run FontWeight="SemiBold" Text="{DynamicResource L10n_About_Step1Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_About_Step1Rest}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"><TextBlock Text="2" Foreground="{StaticResource BrushBackground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480"><Run FontWeight="SemiBold" Text="{DynamicResource L10n_About_Step2Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_About_Step2Rest}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,9">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"><TextBlock Text="3" Foreground="{StaticResource BrushBackground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480"><Run FontWeight="SemiBold" Text="{DynamicResource L10n_About_Step3Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_About_Step3Rest}" /></TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="22" Height="22" CornerRadius="11" Background="{StaticResource BrushAqua}"><TextBlock Text="4" Foreground="{StaticResource BrushBackground}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11" /></Border>
                            <TextBlock TextWrapping="Wrap" Margin="10,1,0,0" FontSize="12.5" Foreground="{StaticResource BrushCream}" MaxWidth="480"><Run FontWeight="SemiBold" Text="{DynamicResource L10n_About_Step4Lead}" /><Run Text=" " /><Run Text="{DynamicResource L10n_About_Step4Rest}" /></TextBlock>
                        </StackPanel>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource L10n_About_PrivacyTitle}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource L10n_About_PrivacyBody}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" Margin="0,8,0,0" LineHeight="20" />
                    <TextBlock Text="{DynamicResource L10n_About_LimitsTitle}" Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" Margin="0,18,0,0" />
                    <TextBlock Text="{DynamicResource L10n_About_LimitsBody}" TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}" Margin="0,8,0,0" LineHeight="20" />

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,16" />

                    <!-- Projects & Social -->
                    <TextBlock Text="{DynamicResource L10n_About_ProjectsSection}"
                               Style="{StaticResource SectionLabel}" Foreground="{StaticResource BrushAqua}" />
                    <TextBlock Text="{DynamicResource L10n_About_StarHint}"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                               Margin="0,8,0,10" LineHeight="20" />

                    <!-- GitHub profile -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,8"
                            Click="OpenLink_Click"
                            Tag="https://github.com/adamwang99"
                            automation:AutomationProperties.Name="Open GitHub profile">
                        <Button.ToolTip>
                            <TextBlock Text="{DynamicResource L10n_About_Social_GitHub_Tip}" />
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="#14FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                                <TextBlock Text="👤" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_About_Social_GitHub_Label}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{DynamicResource L10n_About_Social_GitHub_Url}"
                                           Foreground="{StaticResource BrushMuted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Adam CodexHub repository -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,8"
                            Click="OpenLink_Click"
                            Tag="https://github.com/adamwang99/Adam-CodexHub"
                            automation:AutomationProperties.Name="Open Adam CodexHub repository">
                        <Button.ToolTip>
                            <TextBlock Text="{DynamicResource L10n_About_Social_CodexHub_Tip}" />
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="#14FFFFFF" BorderBrush="{StaticResource BrushHairlineSoft}" BorderThickness="1">
                                <TextBlock Text="📦" FontSize="16"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_About_Social_CodexHub_Label}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{DynamicResource L10n_About_Social_CodexHub_Url}"
                                           Foreground="{StaticResource BrushMuted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Facebook profile -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,8"
                            Click="OpenLink_Click"
                            Tag="https://www.facebook.com/tuanvuonghoang/"
                            automation:AutomationProperties.Name="Open Facebook profile">
                        <Button.ToolTip>
                            <TextBlock Text="{DynamicResource L10n_About_Social_Facebook_Tip}" />
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="#1E1877F2" BorderBrush="#661877F2" BorderThickness="1">
                                <TextBlock Text="f" FontWeight="Bold" FontSize="18" Foreground="#F2FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_About_Social_Facebook_Label}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{DynamicResource L10n_About_Social_Facebook_Url}"
                                           Foreground="{StaticResource BrushMuted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Facebook community group -->
                    <Button HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,9" Margin="0,0,0,6"
                            Click="OpenLink_Click"
                            Tag="https://www.facebook.com/groups/931272648865049"
                            automation:AutomationProperties.Name="Open the Adam Community Facebook group">
                        <Button.ToolTip>
                            <TextBlock Text="{DynamicResource L10n_About_Social_FbGroup_Tip}" />
                        </Button.ToolTip>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="9"
                                    Background="#1E1877F2" BorderBrush="#661877F2" BorderThickness="1">
                                <TextBlock Text="&#x1F465;" FontSize="16" Foreground="#F2FFFFFF"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource L10n_About_Social_FbGroup_Label}"
                                           FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="{DynamicResource L10n_About_Social_FbGroup_Url}"
                                           Foreground="{StaticResource BrushMuted}" FontSize="11" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Border Height="1" Background="{StaticResource BrushHairlineSoft}" Margin="0,16" />

                    <Border CornerRadius="12" Padding="16,13" Background="#14D89B2B"
                            BorderBrush="#59D89B2B" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource L10n_About_FreeTitle}" Foreground="{StaticResource BrushGold}"
                                       FontWeight="Bold" FontSize="12" />
                            <TextBlock Text="{DynamicResource L10n_About_FreeBody}"
                                       TextWrapping="Wrap" FontSize="12.5" Foreground="{StaticResource BrushCream}"
                                       Margin="0,5,0,0" LineHeight="20" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="{DynamicResource L10n_About_OpenGuide}" Click="OpenGuide_Click" Style="{StaticResource PrimaryButton}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
