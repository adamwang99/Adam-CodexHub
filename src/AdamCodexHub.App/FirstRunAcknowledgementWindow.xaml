<Window x:Class="AdamCodexHub.App.FirstRunAcknowledgementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L10n_FR_WindowTitle}"
        Style="{StaticResource AppWindow}"
        Width="700"
        Height="700"
        ResizeMode="NoResize"
        WindowStyle="None"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True">

    <Border Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{DynamicResource L10n_FR_Heading}"
                       FontSize="24"
                       FontWeight="Bold"
                       Foreground="{StaticResource BrushWhite}" />

            <ScrollViewer Grid.Row="1"
                          Margin="0,16,0,16"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="{DynamicResource L10n_FR_Sec1}"
                               Foreground="{StaticResource BrushGold}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12"
                               Text="{DynamicResource L10n_FR_Sec1Body}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushCream}"
                               LineHeight="21" />

                    <TextBlock Text="{DynamicResource L10n_FR_Sec2}"
                               Foreground="{StaticResource BrushGold}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12"
                               Text="{DynamicResource L10n_FR_Sec2Body}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushCream}"
                               LineHeight="21" />

                    <TextBlock Text="{DynamicResource L10n_FR_Sec3}"
                               Foreground="{StaticResource BrushGold}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12"
                               Text="{DynamicResource L10n_FR_Sec3Body}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushCream}"
                               LineHeight="21" />

                    <TextBlock Text="{DynamicResource L10n_FR_Sec4}"
                               Foreground="{StaticResource BrushGold}"
                               FontWeight="SemiBold" />
                    <TextBlock Margin="0,5,0,12"
                               Text="{DynamicResource L10n_FR_Sec4Body}"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource BrushCream}"
                               LineHeight="21" />

                    <TextBlock Margin="0,0,0,16"
                               Foreground="{StaticResource BrushAqua}"
                               TextWrapping="Wrap">
                        <Hyperlink x:Name="PrivacyLink"
                                   NavigateUri="https://github.com/adamwang99/Adam-CodexHub/blob/main/PRIVACY.md"
                                   RequestNavigate="OpenLink">Privacy</Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink x:Name="DisclaimerLink"
                                   NavigateUri="https://github.com/adamwang99/Adam-CodexHub/blob/main/DISCLAIMER.md"
                                   RequestNavigate="OpenLink">Disclaimer</Hyperlink>
                        <Run Text="  ·  " />
                        <Hyperlink x:Name="DisclosuresLink"
                                   NavigateUri="https://github.com/adamwang99/Adam-CodexHub/blob/main/docs/PROVIDER-DATA-DISCLOSURES.md"
                                   RequestNavigate="OpenLink">Provider disclosures</Hyperlink>
                    </TextBlock>

                    <CheckBox x:Name="SessionAcknowledgementCheckBox"
                              Checked="AcknowledgementChanged"
                              Unchecked="AcknowledgementChanged"
                              Foreground="{StaticResource BrushCream}"
                              Margin="0,0,0,10">
                        <TextBlock Width="590"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource L10n_FR_Check1}" />
                    </CheckBox>

                    <CheckBox x:Name="DataAcknowledgementCheckBox"
                              Checked="AcknowledgementChanged"
                              Unchecked="AcknowledgementChanged"
                              Foreground="{StaticResource BrushCream}"
                              Margin="0,0,0,10">
                        <TextBlock Width="590"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource L10n_FR_Check2}" />
                    </CheckBox>

                    <CheckBox x:Name="ResponsibilityAcknowledgementCheckBox"
                              Checked="AcknowledgementChanged"
                              Unchecked="AcknowledgementChanged"
                              Foreground="{StaticResource BrushCream}">
                        <TextBlock Width="590"
                                   TextWrapping="Wrap"
                                   Text="{DynamicResource L10n_FR_Check3}" />
                    </CheckBox>
                </StackPanel>
            </ScrollViewer>

            <Button Grid.Row="2"
                    x:Name="ContinueButton"
                    Style="{StaticResource PrimaryButton}"
                    HorizontalAlignment="Right"
                    IsEnabled="False"
                    Click="Continue_Click"
                    Content="{DynamicResource L10n_FR_Continue}" />
        </Grid>
    </Border>
</Window>
